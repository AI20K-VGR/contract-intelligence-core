# =============================================================================
# Contract Intelligence Backend — Environment Variables Template
#
# Copy this file to .env and fill in the values.
# NEVER commit .env to git (it is in .gitignore).
#
# For Docker Compose, use docker-compose.yml which sets these via environment:.
# For local development without Docker, set these in your shell or .env.
#
# =============================================================================

# =============================================================================
# RUNTIME ENVIRONMENT
# =============================================================================
ENV=dev                  # dev | test | staging | prod
DEBUG=false

# =============================================================================
# DATABASE — PostgreSQL 16 async
# =============================================================================
# Local Docker:     postgresql+asyncpg://ci:ci_secret_dev@localhost:5434/contract_intelligence
# Docker Compose:   postgresql+asyncpg://ci:ci_secret_dev@backend-db:5432/contract_intelligence
DATABASE_URL=postgresql+asyncpg://ci:ci_secret_dev@localhost:5434/contract_intelligence
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# =============================================================================
# AUTHENTICATION — Keycloak SSO (REQUIRED)
#
# IMPORTANT: Backend NEVER issues Access/Refresh tokens.
# Frontend (React) handles login/refresh/logout directly with Keycloak.
# Backend only verifies JWT RS256 signatures via Keycloak JWKS.
#
# LOCAL DOCKER SETUP:
#   KEYCLOAK_SERVER_URL=http://host.docker.internal:8080
#   (host.docker.internal resolves to host machine from inside Docker network)
#
# STAGING/PRODUCTION:
#   Set these to your Keycloak server URL (https://sso.company.com)
# =============================================================================
AUTH_MODE=keycloak                    # Always "keycloak" in staging/prod

# Keycloak server base URL (no trailing slash)
KEYCLOAK_SERVER_URL=http://host.docker.internal:8080

# Realm name (must match realm in Keycloak Admin Console)
KEYCLOAK_REALM=contract-intelligence

# Client ID registered in Keycloak for this backend
# (Backend validates "aud" claim against this value)
KEYCLOAK_CLIENT_ID=contract-intel-backend

# Expected audience claim in JWT. Set to KEYCLOAK_CLIENT_ID or a dedicated audience.
# If not set, audience check is SKIPPED (not recommended for production).
KEYCLOAK_AUDIENCE=contract-intel-backend

# JWKS endpoint URL. If empty (default), auto-built from server_url/realms/{realm}/certs.
# Set this explicitly if your Keycloak uses a non-standard JWKS path.
# KEYCLOAK_JWKS_URI=

# Role mapping: Keycloak realm role → backend RBAC role
# Format: JSON dict as string (single-line for .env)
KEYCLOAK_ROLE_MAP={"ci_operator":"OPERATOR","ci_reviewer":"REVIEWER","ci_administrator":"ADMINISTRATOR"}

# JWKS cache TTL in seconds (default: 3600 = 1 hour)
# Lower this in dev if Keycloak keys rotate frequently.
KEYCLOAK_JWKS_CACHE_TTL_SECONDS=3600

# ----- Keycloak → backend webhook (user lifecycle sync) -----
# The Keycloak instance uses Phase Two keycloak-events with WEBHOOK_URI/
# WEBHOOK_SECRET (see docker-compose.yml). Every event payload is HMAC-
# signed (HmacSHA256) and the signature is sent in the X-Keycloak-Signature
# header. Backend recomputes the HMAC and rejects requests whose signature
# does not match.
#
# MUST match docker-compose.yml → keycloak → WEBHOOK_SECRET.
KEYCLOAK_WEBHOOK_SECRET=ci_webhook_shared_secret_dev

# Set to "false" to skip HMAC verification. ONLY for local debugging —
# never disable in staging/production because the webhook endpoint is
# reachable from anything inside the Docker network.
KEYCLOAK_WEBHOOK_VERIFY_SIGNATURE=true

# =============================================================================
# KEYCLOAK ADMIN REST API (Client Credentials Grant)
#
# Used by the webhook sync handler to fetch full user profile (firstName,
# lastName, email, attributes) after Phase Two delivers a raw Event payload
# that only contains userId. Service account MUST have realm-management
# client role "view-users" — see keycloak/realm-export.json.
#
# Defaults match keycloak/realm-export.json contract-intel-backend client
# (serviceAccountsEnabled=true, secret=backend_secret_dev).
# =============================================================================
KEYCLOAK_ADMIN_CLIENT_ID=contract-intel-backend
KEYCLOAK_ADMIN_CLIENT_SECRET=backend_secret_dev

# TTL cache cho Admin API access token (giây). Keycloak cấp token 5 phút
# theo mặc định; refresh sớm hơn lifespan thực tế.
KEYCLOAK_ADMIN_TOKEN_TTL_SECONDS=300

# HTTP timeout cho Admin REST API call (giây).
KEYCLOAK_ADMIN_HTTP_TIMEOUT_SECONDS=10.0

# =============================================================================
# CORS — Allow frontend origins
# =============================================================================
# Comma-separated list of allowed origins (no trailing comma)
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOW_CREDENTIALS=true

# =============================================================================
# MinIO / S3-compatible file storage
# =============================================================================
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=admin
S3_SECRET_KEY=password123
S3_BUCKET_NAME=dossiers

# Legacy MinIO_* aliases (optional)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=password123
MINIO_BUCKET_PDF=dossiers
MINIO_BUCKET_RENDER=ci-render
MINIO_SECURE=false

# =============================================================================
# Kafka
# =============================================================================
KAFKA_BOOTSTRAP_SERVERS=localhost:9093

# =============================================================================
# AI SERVICE
# =============================================================================
# Mode: "stub" (local dev, no real AI), "http" (connect to ai-service)
AI_SERVICE_MODE=stub
AI_SERVICE_URL=http://localhost:8001
# AI_SERVICE_API_KEY=   # Set if ai-service requires internal auth header
AI_SERVICE_TIMEOUT_SECONDS=30.0

# External AI1 (OCR) / AI2 (Semantics) HTTP adapters (Kafka worker)
AI1_BASE_URL=http://localhost:8001/api/v1
AI2_BASE_URL=http://localhost:8002/api/v1

# =============================================================================
# OPEN TELEMETRY (optional)
# =============================================================================
OTEL_SERVICE_NAME=contract-intelligence-backend
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_EXPORTER_CONSOLE=false

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=INFO
