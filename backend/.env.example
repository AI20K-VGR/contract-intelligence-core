CI_DATABASE_URL=postgresql+psycopg://ci:ci@localhost:5432/ci
CI_ARTIFACT_ROOT=../data/artifacts

# Scan pages always run through Tesseract first for line bbox/order. Leave CI_OCR_ENGINE
# unset (or "tesseract") for the no-external-API local_baseline profile. Set to
# "gpt_vision" for the terra_assisted profile: Tesseract still anchors bbox/order, but a
# GPT vision call re-transcribes the page and its text replaces each Tesseract line's
# text when the line counts match (falls back to the Tesseract text, flagged for review,
# otherwise). Sends page images to OpenAI — only for non-confidential test documents.
# CI_OCR_ENGINE=gpt_vision
# CI_OPENAI_API_KEY=sk-...
# CI_OCR_VISION_MODEL=gpt-5.6-terra

# Alternative to gpt_vision: "mistral_vision" (mistral_assisted profile) follows the
# exact same Tesseract-anchored re-transcription/alignment shape, only sourced from
# Mistral's dedicated OCR endpoint (client.ocr.process, model mistral-ocr-4) instead of
# a chat completion. Mutually exclusive with gpt_vision — set CI_OCR_ENGINE to one or
# the other, never both. Sends page images to Mistral — only for non-confidential test
# documents. Get a key at console.mistral.ai.
# CI_OCR_ENGINE=mistral_vision
# CI_MISTRAL_API_KEY=...
# CI_OCR_MISTRAL_MODEL=mistral-ocr-4

# "mistral_vision_only" / "gpt_vision_only": Tesseract is NOT run at all for a
# scanned/mixed page -- the vision provider is the SOLE source of both text and table
# structure (one full-page call), not a substitution layered on top of Tesseract's own
# geometry like the two modes above. Every bbox this produces is "inferred" (an even
# grid/vertical split, never a real measurement) -- a deliberate tradeoff: correct text
# and table structure, at the cost of citation/bbox precision. Use when Tesseract's own
# word-position clustering is doing more harm than good (silently dropping/merging
# table columns). mistral_vision_only is live-verified against real scanned tables;
# gpt_vision_only mirrors its shape but has NOT been checked against a real page (GPT's
# own transcription prompt forbids markdown, so it needs a second, separate table-only
# call with no cropped region to work from -- see _GPT_VISION_FULL_PAGE_TABLE_PROMPT in
# document_processing.py). Same keys as above; CI_MISTRAL_API_KEY/CI_OPENAI_API_KEY.
# CI_OCR_ENGINE=mistral_vision_only
# CI_OCR_ENGINE=gpt_vision_only

# Table Continuity Agent (app/table_continuity.py): judges a genuinely ambiguous
# cross-page table pair (rule engine alone can't confidently MERGE or SPLIT it).
# Opt-in per dossier via POST /dossiers/{id}/jobs {"table_continuity_agent": true} —
# setting the key here only makes the *capability* available, it does not enable it
# for every dossier. Sends a small metadata/text packet (never a page image, never a
# full table) to DeepSeek's hosted API — only for non-confidential test documents.
# CI_DEEPSEEK_API_KEY=sk-...
# CI_DEEPSEEK_BASE_URL=https://api.deepseek.com
# CI_DEEPSEEK_MODEL=deepseek-flash
