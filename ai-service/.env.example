OCR_DPI=300
OCR_DEEPSEEK_BACKEND=transformers
OCR_DEEPSEEK_MODEL=deepseek-ai/DeepSeek-OCR-2
HF_HUB_OFFLINE=1

# Test UI backend only (scripts/serve_backend.py), not the CLI/benchmark pipeline above.
# Enables the OpenAI GPT-4o vision engine in the test UI; leave empty to keep it disabled.
# Sends page images to OpenAI when used — see README "OpenAI (tuỳ chọn)".
OPENAI_API_KEY=

# Enables the Gemini vision engine in the test UI; leave empty to keep it disabled.
# Sends page images to Google when used — see README "Gemini (tuỳ chọn)".
GEMINI_API_KEY=
# Override if the default model ID in gemini_vision_ocr.py no longer matches
# https://ai.google.dev/gemini-api/docs/models
# GEMINI_MODEL=gemini-3-flash-preview

# Enables the "DeepSeek Flash (API)" vision engine in the test UI (hosted API, model
# deepseek-flash) — different from OCR_DEEPSEEK_MODEL above, which is the local
# GPU-only deepseek-ai/DeepSeek-OCR-2 adapter used by the CLI benchmark. Get a key at
# platform.deepseek.com. Leave empty to keep this engine disabled.
DEEPSEEK_API_KEY=

# Enables the Mistral OCR (Document AI) engine in the test UI; leave empty to keep it
# disabled. Sends page images to Mistral when used — see README "Mistral (tuỳ chọn)".
# Uses Mistral's dedicated OCR endpoint (model pinned to mistral-ocr-4 in
# mistral_ocr.py, not the mistral-ocr-latest alias), not a chat-completion vision prompt
# like the three engines above, so it does not go through this project's shared
# anti-hallucination system prompt. Get a key at console.mistral.ai.
MISTRAL_API_KEY=

# =============================================================================
# AI1 OCR — engine "mistral" (VerifiedMistralOCREngine)
# Chi tiết: ai-service/docs/architecture_ai1.md (mục 6, 10, 19)
#
# Mỗi trang scan đi qua:
#   1. AI1_TEXT_MODEL đọc chữ (đọc đúng dấu tiếng Việt, không có toạ độ)
#   2. OpenCV đo toạ độ từng dòng (chạy local, miễn phí)
#   3. AI1_VERIFIER_MODEL đọc lần hai: toạ độ, chữ số, đối chiếu từ
#      (chữ có dấu của model này KHÔNG dùng — thế hệ 4.x hay mất dấu)
#   4. GPT đọc lại vùng cắt của dòng còn mâu thuẫn, bỏ phiếu 2/3
# Trang có lớp chữ gốc (PDF số), trang trắng, trang trùng: không gọi model nào.
#
# Sau khi sửa file này phải TẠO LẠI container (restart không đọc lại .env):
#   docker compose up -d ai1-worker
# =============================================================================

# --- Chế độ chi phí (quan trọng nhất) ---------------------------------------
# budget   : ~$4.4 / 1.000 trang scan, nhanh hơn (đo trên bộ hard case).
#            - 4-1 chỉ chạy khi >= 25% số dòng không đo được toạ độ, có mực bị
#              bỏ sót (vd tên người ký), hoặc có bảng không viền.
#            - Số tiền / ngày / số hợp đồng KHÔNG được 4-1 xác minh mà gắn cờ
#              needs_review:critical_field_unverified cho người kiểm.
#            - GPT chỉ đọc vùng cắt, không bao giờ đọc cả trang.
#            - Mất: phát hiện 2512 thay nhầm một từ hợp lệ; tự loại chữ bịa
#              (chữ bịa chỉ bị gắn cờ); vài dòng giữ bbox ước lượng (CLAIMED).
# accuracy : ~$10.1 / 1.000 trang scan. 4-1 đọc mọi trang (song song, không
#            tăng thời gian chờ), xác minh mọi chữ số, tự loại chữ bịa, ít cờ
#            review hơn (11 so với 67 trên bộ hard case).
# Chất lượng chữ đo được gần như nhau: CER 1.11% (budget) / 1.00% (accuracy),
# Critical Field Accuracy 99.5% ở cả hai.
AI1_COST_MODE=budget
# Kiểm tra chất lượng từng trang scan trước khi gọi OCR (nhoè, tương phản thấp,
# nhiễu hạt, chấm bẩn); chạy cục bộ, không tốn tiền. >= 3 trang VÀ >= 30% trang cần OCR bị xấu
# thì từ chối cả file với lỗi AI1_LOW_QUALITY_DOCUMENT, không gọi model nào.
# Ít hơn thì trang xấu chỉ đọc 1 lần (không 4-1, không GPT đọc lại/phân xử) và
# ghi cảnh báo low_quality_scan:<lý do>. false = tắt kiểm tra.
AI1_PAGE_QUALITY_CHECK=true

# --- Model -------------------------------------------------------------------
# Người đọc chính. mistral-ocr-2512 (OCR 3) đọc đúng dấu 12/12 trang đã đo;
# các model 4.x mất dấu 6/12 trang -> không đổi sang 4.x ở đây.
AI1_TEXT_MODEL=mistral-ocr-2512
# Người đọc đối chiếu (toạ độ, chữ số). Không để trống: tiết kiệm bằng AI1_COST_MODE.
AI1_VERIFIER_MODEL=mistral-ocr-4-1
# Chỉ có tác dụng ở chế độ accuracy: true = 4-1 đọc mọi trang (khuyên dùng);
# false = chỉ khi cổng kiểm tra nghi ngờ. Chế độ budget luôn coi là false.
AI1_VERIFY_ALL_PAGES=true
# GPT (model gpt-5.6-terra, cần OPENAI_API_KEY ở trên) chỉ chép lại chữ, không
# cần "suy nghĩ". none = không trả tiền token suy luận ẩn (rẻ hơn ~17%, CER
# không đổi). Giá trị hợp lệ: none | low | medium | high | xhigh.
AI1_GPT_REASONING_EFFORT=none

# --- Tốc độ ------------------------------------------------------------------
# Số trang OCR song song trong một tài liệu. Mọi lời gọi model đều chờ mạng,
# nên tăng số này rút ngắn thời gian gần như tuyến tính cho tới khi chạm giới
# hạn rate limit của Mistral/OpenAI (gặp lỗi 429 thì giảm xuống).
AI1_MAX_PAGES_IN_FLIGHT=8
# Quá thời gian (ms) thì bỏ lượt gọi đó: người đọc chính chuyển sang GPT đọc cả
# trang; người đối chiếu thì trang được gắn cờ thay vì chờ.
AI1_TEXT_TIMEOUT_MS=20000
AI1_VERIFIER_TIMEOUT_MS=20000

# --- Giá (chỉ dùng để ghi chi phí lên Langfuse; không ảnh hưởng xử lý) -------
# USD mỗi trang, theo giá công bố của Mistral: OCR 3 (2512) $2/1.000 trang,
# OCR 4 (4-1) $4/1.000 trang. Giá GPT tính tự động theo token.
AI1_TEXT_PRICE_PER_PAGE_USD=0.002
AI1_VERIFIER_PRICE_PER_PAGE_USD=0.004

# Langfuse observability. Traces intentionally contain operational metadata and
# aggregate counts only; contract text, page images, presigned URLs, and prompts
# containing customer content are not captured.
LANGFUSE_TRACING_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development
LANGFUSE_SAMPLE_RATE=1.0
LANGFUSE_OBSERVE_DECORATOR_IO_CAPTURE_ENABLED=false
OTEL_SERVICE_NAME=contract-ocr-ai1

# Kafka worker (Backend ↔ AI1 OCR — docs/DOC-05d-kafka-ai1-ocr-contract.md)
# uv run --extra kafka python -m contract_ocr.infrastructure.kafka_worker
KAFKA_BOOTSTRAP_SERVERS=localhost:9093
KAFKA_AI1_OCR_COMMANDS_TOPIC=ci.ai1.ocr.commands
KAFKA_AI1_OCR_RESULTS_TOPIC=ci.ai1.ocr.results
KAFKA_AI1_OCR_GROUP_ID=ci-ai1-ocr

# AI2 canonical IDP service
# OpenAI trực tiếp; chỉ bật egress sau khi cấu hình key riêng cho môi trường.
AI2_LLM_BASE_URL=https://api.openai.com/v1
AI2_LLM_API_KEY=
AI2_LLM_MODEL=gpt-4o-mini
AI2_LLM_STRONG_MODEL=gpt-4o-mini
AI2_EMBEDDING_BASE_URL=https://api.openai.com/v1
AI2_EMBEDDING_API_KEY=
AI2_EMBEDDING_MODEL=text-embedding-3-small
AI2_EMBEDDING_BATCH_SIZE=16
AI2_EMBEDDING_DISCOVERY_ENABLED=false
AI2_VECTOR_RECALL_ENABLED=false
AI2_PROCESSING_EGRESS_ALLOWED=false
AI2_QUERY_EGRESS_ALLOWED=false
AI2_QUERY_USE_LLM=false
AI2_QUERY_USE_VECTOR=false
AI2_QUERY_REQUIRE_SIGNATURE=true
AI2_QUERY_LLM_TIMEOUT_SECONDS=15
# Dev/test có thể để URL trống; compose bắt buộc PostgreSQL.
AI2_DATABASE_URL=
AI2_REQUIRE_DATABASE=false
# AI2_VECTOR_DB=data/ai2/vectors.sqlite
