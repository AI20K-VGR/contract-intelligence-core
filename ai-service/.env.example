OCR_DPI=300
OCR_DEEPSEEK_BACKEND=transformers
OCR_DEEPSEEK_MODEL=deepseek-ai/DeepSeek-OCR-2
HF_HUB_OFFLINE=1

# Test UI backend only (scripts/serve_backend.py), not the CLI/benchmark pipeline above.
# Enables the OpenAI GPT-4o vision engine in the test UI; leave empty to keep it disabled.
# Sends page images to OpenAI when used — see README "OpenAI (tuỳ chọn)".
OPENAI_API_KEY=

# Enables the Gemini vision engine in the test UI; leave empty to keep it disabled.
# Sends page images to Google when used — see README "Gemini (tuỳ chọn)".
GEMINI_API_KEY=
# Override if the default model ID in gemini_vision_ocr.py no longer matches
# https://ai.google.dev/gemini-api/docs/models
# GEMINI_MODEL=gemini-3-flash-preview

# Enables the "DeepSeek Flash (API)" vision engine in the test UI (hosted API, model
# deepseek-flash) — different from OCR_DEEPSEEK_MODEL above, which is the local
# GPU-only deepseek-ai/DeepSeek-OCR-2 adapter used by the CLI benchmark. Get a key at
# platform.deepseek.com. Leave empty to keep this engine disabled.
DEEPSEEK_API_KEY=

# Enables the Mistral OCR (Document AI) engine in the test UI; leave empty to keep it
# disabled. Sends page images to Mistral when used — see README "Mistral (tuỳ chọn)".
# Uses Mistral's dedicated OCR endpoint (model pinned to mistral-ocr-4 in
# mistral_ocr.py, not the mistral-ocr-latest alias), not a chat-completion vision prompt
# like the three engines above, so it does not go through this project's shared
# anti-hallucination system prompt. Get a key at console.mistral.ai.
MISTRAL_API_KEY=

# Backend OCR jobs with engine "mistral" run VerifiedMistralOCREngine
# (infrastructure/ocr/verified_mistral_ocr.py): text from AI1_TEXT_MODEL (reads
# Vietnamese accents correctly, no geometry), boxes from local OpenCV, an
# independent second reading from AI1_VERIFIER_MODEL (geometry, digits, word
# agreement; its accents are never used), GPT vision only to break ties.
# AI1_VERIFY_ALL_PAGES=false calls the verifier only on pages the gate doubts:
# cheaper, but a valid-word substitution by the text reader can then go unseen.
AI1_TEXT_MODEL=mistral-ocr-2512
AI1_VERIFIER_MODEL=mistral-ocr-4-1
AI1_VERIFY_ALL_PAGES=true
AI1_TEXT_TIMEOUT_MS=20000
AI1_VERIFIER_TIMEOUT_MS=20000
# USD per page, attached to Langfuse as cost_details (Langfuse cannot price
# these model ids itself). Leave the verifier price empty until confirmed.
AI1_TEXT_PRICE_PER_PAGE_USD=0.002
AI1_VERIFIER_PRICE_PER_PAGE_USD=

# Langfuse observability. Traces intentionally contain operational metadata and
# aggregate counts only; contract text, page images, presigned URLs, and prompts
# containing customer content are not captured.
LANGFUSE_TRACING_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development
LANGFUSE_SAMPLE_RATE=1.0
LANGFUSE_OBSERVE_DECORATOR_IO_CAPTURE_ENABLED=false
OTEL_SERVICE_NAME=contract-ocr-ai1

# Kafka worker (Backend ↔ AI1 OCR — docs/DOC-05d-kafka-ai1-ocr-contract.md)
# uv run --extra kafka python -m contract_ocr.infrastructure.kafka_worker
KAFKA_BOOTSTRAP_SERVERS=localhost:9093
KAFKA_AI1_OCR_COMMANDS_TOPIC=ci.ai1.ocr.commands
KAFKA_AI1_OCR_RESULTS_TOPIC=ci.ai1.ocr.results
KAFKA_AI1_OCR_GROUP_ID=ci-ai1-ocr

# AI2 canonical IDP service
AI2_LLM_BASE_URL=http://localhost:20128/v1
AI2_LLM_API_KEY=sk-replace-me
AI2_LLM_MODEL=gh/gpt-4o
AI2_LLM_STRONG_MODEL=gh/gpt-4o
AI2_EMBEDDING_BASE_URL=http://localhost:20128/v1
AI2_EMBEDDING_API_KEY=sk-replace-me
AI2_EMBEDDING_BATCH_SIZE=16
AI2_EMBEDDING_DISCOVERY_ENABLED=false
AI2_VECTOR_RECALL_ENABLED=false
# AI2_VECTOR_DB=data/ai2/vectors.sqlite
