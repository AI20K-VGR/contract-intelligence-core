          "type": "integer"
        },
        "image_coverage_ratio": {
          "maximum": 1,
          "minimum": 0,
          "title": "Image Coverage Ratio",
          "type": "number"
        },
        "usable_text": {
          "title": "Usable Text",
          "type": "boolean"
        }
