        "raw_output_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Output Path"
        },
        "geometry_available": {
          "default": false,
          "title": "Geometry Available",
          "type": "boolean"
        },
        "preprocessing": {
          "items": {
            "type": "string"
          },
          "title": "Preprocessing",
          "type": "array"
        },
        "transform": {
          "anyOf": [
