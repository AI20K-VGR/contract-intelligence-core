FROM ghcr.io/astral-sh/uv:0.11.32 AS uv_stage
FROM python:3.12-slim

WORKDIR /app

COPY --from=uv_stage /uv /usr/local/bin/uv

ENV PYTHONPATH=/app \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --extra web --extra openai --no-dev
RUN uv pip install --python /app/.venv/bin/python pypdf reportlab jsonschema

COPY app/ app/
COPY fixtures/ fixtures/
COPY data/ data/

EXPOSE 8002

CMD ["uv", "run", "--no-sync", "uvicorn", "app.api.main:app", "--host", "0.0.0.0", "--port", "8002"]
