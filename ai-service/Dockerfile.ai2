FROM ghcr.io/astral-sh/uv:0.7.13

WORKDIR /app

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    VIRTUAL_ENV=/app/.venv \
    PATH="/app/.venv/bin:$PATH" \
    PYTHONPATH=/app \
    PYTHONUNBUFFERED=1

COPY pyproject.toml uv.lock ./
# web = FastAPI demo HTTP; kafka = DOC-05e IDP worker (same image, different CMD).
RUN uv sync --frozen --extra web --extra kafka --no-dev --no-install-project

COPY app/ app/
COPY fixtures/ fixtures/

EXPOSE 8002
# Default: demo HTTP API. Compose ``ai2-worker`` overrides CMD to kafka_idp_worker.
CMD ["uv", "run", "--frozen", "--extra", "web", "uvicorn", "app.api.main:app", "--host", "0.0.0.0", "--port", "8002"]
