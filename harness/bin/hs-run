#!/bin/sh
# hs-run — deterministic step-sequence CLI over the harness's plan/cook scripts
# (POSIX launcher). Sibling to hs-cli, never a replacement (survival invariant #1).
#
# Resolves the harness root from THIS script's own location, following a symlink
# chain so a ~/.local/bin/hs-run symlink still finds the repo, then delegates
# every domain/verb to harness/scripts/hs_run.py. No logic lives here — it is one
# discoverable, on-PATH entry point. Cross-platform twin: hs-run.cmd (Windows).
set -e

# Follow the symlink chain to the real script path (readlink -f is not portable
# to macOS, so walk it by hand).
src="$0"
while [ -L "$src" ]; do
    dir=$(cd -P "$(dirname "$src")" >/dev/null 2>&1 && pwd)
    target=$(readlink "$src")
    case "$target" in
        /*) src="$target" ;;
        *)  src="$dir/$target" ;;
    esac
done
bin_dir=$(cd -P "$(dirname "$src")" >/dev/null 2>&1 && pwd)
root=$(cd "$bin_dir/.." >/dev/null 2>&1 && pwd)   # harness/bin -> harness
run="$root/scripts/hs_run.py"

if [ ! -f "$run" ]; then
    echo "hs-run: cannot find $run — is the harness installed at $root?" >&2
    exit 1
fi

# Prefer python3; fall back to python (some distros ship only `python`).
if command -v python3 >/dev/null 2>&1; then
    exec python3 "$run" "$@"
elif command -v python >/dev/null 2>&1; then
    exec python "$run" "$@"
else
    echo "hs-run: python3 not found — install Python 3 to run the harness CLI." >&2
    exit 1
fi
