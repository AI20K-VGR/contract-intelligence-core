# Copy to .env.e2e. Do not commit the copied file.
# The runner fails fast when required provider keys/capabilities are missing.

ENV=dev
FRONTEND_HOST_PORT=5173
VITE_API_BASE_URL=http://localhost:8000
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=contract-intelligence
VITE_KEYCLOAK_CLIENT_ID=contract-intel-frontend

BACKEND_DB_PASSWORD=
AI2_DB_PASSWORD=
AI2_SERVICE_HMAC_SECRET=
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_WEBHOOK_SECRET=
BACKEND_KEYCLOAK_ADMIN_SECRET=

# AI1 OCR provider. Set a real provider key before uploading a PDF.
MISTRAL_API_KEY=
AI1_TEXT_MODEL=mistral-ocr-2512
AI1_VERIFIER_MODEL=mistral-ocr-4-1
AI1_COST_MODE=budget

# AI2 full path. Set a real LLM/embedding key or compatible endpoint.
AI2_LLM_BASE_URL=https://api.openai.com/v1
AI2_LLM_API_KEY=
AI2_LLM_MODEL=gpt-4o-mini
AI2_LLM_STRONG_MODEL=gpt-4o-mini
AI2_EMBEDDING_BASE_URL=https://api.openai.com/v1
AI2_EMBEDDING_API_KEY=
AI2_EMBEDDING_MODEL=text-embedding-3-small
AI2_EMBEDDING_DISCOVERY_ENABLED=true
AI2_DATABASE_URL=
AI2_REQUIRE_DATABASE=true
AI2_SEMANTIC_ENABLED=true
AI2_SEMANTIC_PROFILE_CONFIG='{"version":1,"contract_type":"SALES","context_bounds":{"max_hops":2,"max_nodes":256,"max_context_tokens":32768,"max_output_tokens":8192,"max_llm_calls":20,"max_seconds":300},"alias_proposal_minimum_length":4}'
AI2_SEMANTIC_CONTEXT_CAPS='{"max_hops":2,"max_nodes":256,"max_context_tokens":32768,"max_output_tokens":8192,"max_llm_calls":20,"max_seconds":300}'
AI2_PROCESSING_EGRESS_ALLOWED=true
AI2_QUERY_EGRESS_ALLOWED=true
AI2_QUERY_USE_LLM=true
AI2_QUERY_USE_VECTOR=true
AI2_VECTOR_RECALL_ENABLED=true
AI2_QUERY_REQUIRE_SIGNATURE=true

# Backend / storage / mail defaults for the disposable E2E stack.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_BASE_URL=http://localhost:5173
S3_ACCESS_KEY=
S3_SECRET_KEY=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=lexis@localhost
