{
  "schema": "ai2.p2.state-transition-matrix.v1",
  "phase": "P2",
  "scope": "durable-domain reducer and HITL command validation; no persistence, transport, or P3 work",
  "implementation": {
    "module": "ai-service/app/reasoning/state_machine.py",
    "machine": "DurableReasoningStateMachine",
    "concurrency_boundary": "in-process RLock plus expected_state_version compare-and-set",
    "idempotency_boundary": "per-run idempotency_key receipt with fingerprint conflict detection"
  },
  "states": [
    "CREATED",
    "RUNNING",
    "WAITING_FOR_HUMAN",
    "RESUMING",
    "RECOMPUTING",
    "COMPLETED",
    "FAILED",
    "CANCELLED",
    "EXPIRED"
  ],
  "transitions": [
    {"from": "CREATED", "command": "START", "to": "RUNNING"},
    {"from": "CREATED", "command": "CANCEL", "to": "CANCELLED"},
    {"from": "CREATED", "command": "EXPIRE", "to": "EXPIRED"},
    {"from": "CREATED", "command": "TIMEOUT", "to": "EXPIRED"},
    {"from": "RUNNING", "command": "REQUEST_CONTEXT", "to": "WAITING_FOR_HUMAN"},
    {"from": "RUNNING", "command": "COMPLETE", "to": "COMPLETED"},
    {"from": "RUNNING", "command": "FAIL", "to": "FAILED"},
    {"from": "RUNNING", "command": "CANCEL", "to": "CANCELLED"},
    {"from": "RUNNING", "command": "EXPIRE", "to": "EXPIRED"},
    {"from": "RUNNING", "command": "TIMEOUT", "to": "EXPIRED"},
    {"from": "WAITING_FOR_HUMAN", "command": "REQUEST_CONTEXT", "to": "WAITING_FOR_HUMAN"},
    {"from": "WAITING_FOR_HUMAN", "command": "APPROVE", "to": "RESUMING"},
    {"from": "WAITING_FOR_HUMAN", "command": "REJECT", "to": "RESUMING"},
    {"from": "WAITING_FOR_HUMAN", "command": "EDIT", "to": "RESUMING"},
    {"from": "WAITING_FOR_HUMAN", "command": "CONFIRM_IMPACT", "to": "RESUMING"},
    {"from": "WAITING_FOR_HUMAN", "command": "RESUME", "to": "RESUMING"},
    {"from": "WAITING_FOR_HUMAN", "command": "CANCEL", "to": "CANCELLED"},
    {"from": "WAITING_FOR_HUMAN", "command": "EXPIRE", "to": "EXPIRED"},
    {"from": "WAITING_FOR_HUMAN", "command": "TIMEOUT", "to": "EXPIRED"},
    {"from": "RESUMING", "command": "RECOMPUTE", "to": "RECOMPUTING"},
    {"from": "RESUMING", "command": "FAIL", "to": "FAILED"},
    {"from": "RESUMING", "command": "CANCEL", "to": "CANCELLED"},
    {"from": "RESUMING", "command": "EXPIRE", "to": "EXPIRED"},
    {"from": "RESUMING", "command": "TIMEOUT", "to": "EXPIRED"},
    {"from": "RECOMPUTING", "command": "START", "to": "RUNNING"},
    {"from": "RECOMPUTING", "command": "REQUEST_CONTEXT", "to": "WAITING_FOR_HUMAN"},
    {"from": "RECOMPUTING", "command": "COMPLETE", "to": "COMPLETED"},
    {"from": "RECOMPUTING", "command": "FAIL", "to": "FAILED"},
    {"from": "RECOMPUTING", "command": "CANCEL", "to": "CANCELLED"},
    {"from": "RECOMPUTING", "command": "EXPIRE", "to": "EXPIRED"},
    {"from": "RECOMPUTING", "command": "TIMEOUT", "to": "EXPIRED"}
  ],
  "terminal_states": ["COMPLETED", "FAILED", "CANCELLED", "EXPIRED"],
  "authorization": {
    "tenant": "command.tenant_id must equal state.tenant_id",
    "generation": "command.generation_id must equal state.generation_id",
    "roles": {
      "START": ["operator", "system", "admin"],
      "REQUEST_CONTEXT": ["owner", "reviewer", "approver", "operator", "admin"],
      "APPROVE": ["approver", "admin"],
      "REJECT": ["reviewer", "approver", "admin"],
      "EDIT": ["reviewer", "approver", "admin"],
      "CONFIRM_IMPACT": ["approver", "admin"],
      "RESUME": ["reviewer", "approver", "operator", "admin"],
      "RECOMPUTE": ["operator", "system", "admin"],
      "COMPLETE": ["system", "admin"],
      "FAIL": ["operator", "system", "admin"],
      "CANCEL": ["owner", "operator", "system", "admin"],
      "TIMEOUT": ["operator", "system", "admin"],
      "EXPIRE": ["operator", "system", "admin"]
    }
  },
  "invariants": [
    "expected_state_version must equal the current version before a transition",
    "accepted transitions increment state_version exactly once",
    "same idempotency key and fingerprint return the original immutable CommandResult",
    "same idempotency key with a different fingerprint returns IDEMPOTENCY_CONFLICT",
    "only one concurrent command can win a shared expected_state_version",
    "approval is explicit; no transition infers approval from context or model output",
    "REQUEST_CONTEXT requires a non-empty question",
    "EDIT requires non-empty edits/changes",
    "CONFIRM_IMPACT requires confirmed=true and a non-empty impact_id",
    "REJECT and CANCEL require a non-empty reason",
    "all first-seen accepted and rejected commands produce audit-ready fields"
  ],
  "error_catalog": [
    "RUN_MISMATCH",
    "UNAUTHORIZED_TENANT",
    "STALE_GENERATION",
    "EXPIRED",
    "UNAUTHORIZED_ROLE",
    "STALE_STATE_VERSION",
    "INVALID_TRANSITION",
    "INVALID_CONTEXT",
    "IDEMPOTENCY_CONFLICT"
  ],
  "verification": {
    "command": "pytest tests/test_p2_hitl_state.py -q --basetemp .pytest-p2-codex-final",
    "result": "11 passed",
    "full_suite": "not_run_by_user_request",
    "covered_tests": [
      "test_transition_matrix_and_no_auto_approve",
      "test_context_and_edit_commands_require_complete_payload",
      "test_stale_version_generation_and_expired_commands_are_deterministic",
      "test_idempotent_retry_returns_same_result_and_conflict_is_rejected",
      "test_authorization_tenant_and_role_are_enforced",
      "test_cancel_expire_race_has_one_winner",
      "test_concurrent_approvals_have_one_cas_winner",
      "test_timeout_cancel_race_has_one_winner",
      "test_rejected_command_and_accepted_command_have_audit_contract"
    ]
  }
}
