# deploy/.env.db — settings of the DB server (deploy/compose.db.yml).
#
# `bootstrap.sh --db` creates deploy/.env.db from this file, fills
# DB_BIND_ADDR with the machine's private address and every "generate"
# secret with random values. Never commit deploy/.env.db.
#
# The app server needs the same passwords and ports in its deploy/.env.prod,
# with BACKEND_DB_HOST and KEYCLOAK_DB_HOST = DB_BIND_ADDR below.

# Private address of this machine (AWS: the instance's private IPv4).
# Never the public one: the databases would listen on the Internet side.
DB_BIND_ADDR=10.0.0.10

BACKEND_DB_PASSWORD=generate
KEYCLOAK_DB_PASSWORD=generate

# Ports on DB_BIND_ADDR.
BACKEND_DB_PORT=5432
KEYCLOAK_DB_PORT=5433
