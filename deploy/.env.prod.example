# deploy/.env.prod — production settings for deploy/compose.prod.yml.
#
# bootstrap.sh creates deploy/.env.prod from this file and fills every
# "generate" secret with random values. Never commit deploy/.env.prod.

# ---- Public hostnames (sslip.io resolves api-1-2-3-4.sslip.io → 1.2.3.4) ----
API_HOST=api-203-0-113-10.sslip.io
AUTH_HOST=auth-203-0-113-10.sslip.io
APP_HOST=app-203-0-113-10.sslip.io

# ---- Frontend ----
# Host of the frontend served by this server (deploy/compose.frontend.yml).
# Empty = this server hosts no frontend; the team runs it elsewhere.
# Origins allowed by CORS and by the Keycloak frontend client, comma-separated.
# Must contain https://$APP_HOST when APP_HOST is set. localhost:5173 lets the
# team call this API from a local frontend (CORS).
FRONTEND_ORIGINS=https://app-203-0-113-10.sslip.io,http://localhost:5173,http://127.0.0.1:5173
# Keycloak redirects to localhost (log in from a local frontend against this
# server). Off by default: a login code must not be sent to a page on the
# user's own machine. true while the team needs it; off for a pentest.
KEYCLOAK_KEEP_LOCAL_REDIRECTS=false

# ---- Cloudflare (deploy/compose.cloudflare-aop.yml) ----
# Zone-level Authenticated Origin Pulls, used only when deploy/certs/
# origin-pull-ca.pem exists. verify_if_given until the zone-level setting is on
# in Cloudflare and checked, then require_and_verify. In the other order every
# site goes down. See deploy/README.md, "Đứng sau Cloudflare".
ORIGIN_CLIENT_AUTH=verify_if_given
# Base URL used in share / invitation e-mails.
FRONTEND_BASE_URL=https://app-203-0-113-10.sslip.io

# ---- Secrets (generate) ----
KEYCLOAK_DB_PASSWORD=generate
BACKEND_DB_PASSWORD=generate
# Role ai2 on backend-db (schema ai2 only); ai2-service connects with it.
AI2_DB_PASSWORD=generate
KEYCLOAK_ADMIN_PASSWORD=generate
BACKEND_KEYCLOAK_ADMIN_SECRET=generate
KEYCLOAK_WEBHOOK_SECRET=generate
AI2_SERVICE_HMAC_SECRET=generate
MINIO_ROOT_USER=ci-minio
MINIO_ROOT_PASSWORD=generate

# Passwords for the demo accounts seeded by keycloak/realm-export.json
# (the committed ones are public). Share them with the team privately.
DEMO_ADMIN_PASSWORD=generate
DEMO_REVIEWER_PASSWORD=generate
DEMO_OPERATOR_PASSWORD=generate

# ---- Databases on a DB server of their own (optional) ----
# Empty = both Postgres run on this server. Set to the DB server's PRIVATE
# address (deploy/compose.db.yml) to keep them there; set both or neither.
# The passwords above and the ports below must then be the ones in that
# server's deploy/.env.db (5432 and 5433 there). Leave the ports empty while
# the hosts are: on this server both databases listen on 5432.
BACKEND_DB_HOST=
BACKEND_DB_PORT=
KEYCLOAK_DB_HOST=
KEYCLOAK_DB_PORT=

# ---- AI2 LLM (Lead chooses the provider, key owner and spending cap) ----
AI2_LLM_BASE_URL=
AI2_LLM_API_KEY=
AI2_LLM_MODEL=gpt-5.5
AI2_LLM_STRONG_MODEL=gpt-5.5
# Low reasoning for span-picking semantic/alias calls (#124); empty = model default.
AI2_LLM_LIGHT_REASONING_EFFORT=low
# Empty: GPT-5 probes use 64 tokens / 15 seconds; other models use 1 / 3.
AI2_LLM_PROBE_MAX_TOKENS=
AI2_LLM_PROBE_TIMEOUT_SECONDS=
AI2_CONTRACT_GRAPH_ENABLED=true
AI2_CONTRACT_GRAPH_PAIRS_ENABLED=true
AI2_CONTRACT_GRAPH_PAIRS_MODEL=gpt-5.5
# Pair classifier endpoint and key, set together (AI2 owns the key, D6).
# Empty: the contract graph skips pairs (RULE_ONLY_LLM_UNAVAILABLE).
AI2_CONTRACT_GRAPH_PAIRS_BASE_URL=
AI2_CONTRACT_GRAPH_PAIRS_API_KEY=
# Pair batches sent in parallel per job; 1 = quay về tuần tự (rollback switch).
AI2_PAIRS_CONCURRENCY=5
# Pairs reasoning effort: minimal|low|medium|high; empty hoặc provider_default = không gửi effort.
# Chỉ đổi sau lần xác nhận OpenAI gpt-5.5 (plan 261017-1821, F3.9).
AI2_PAIRS_REASONING_EFFORT=
AI2_SEMANTIC_ENABLED=true
AI2_PROCESSING_EGRESS_ALLOWED=true
AI2_QUERY_EGRESS_ALLOWED=true
AI2_QUERY_USE_LLM=true
AI2_QUERY_USE_VECTOR=true
AI2_VECTOR_RECALL_ENABLED=true
AI2_EMBEDDING_DISCOVERY_ENABLED=false
# Keep generated graph relations in review; do not auto-approve them.
AI2_CONTRACT_GRAPH_AUTO_PASS=false
AI2_EMBEDDING_BASE_URL=
AI2_EMBEDDING_API_KEY=
AI2_EMBEDDING_MODEL=text-embedding-3-small
# Langfuse for ai2-service: one trace per question (/query) with token usage and
# USD cost per LLM/embedding call; no question, prompt or answer text. Empty = off.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=production
LANGFUSE_SAMPLE_RATE=1.0
# USD per 1M tokens for models AI2 does not price yet (gpt-5.5 and
# text-embedding-3-small are built in), e.g. {"gpt-5.6": {"input": 2, "output": 12}}.
AI2_LLM_PRICES_JSON=

# AI1 keys (MISTRAL_API_KEY, ...) stay in ai-service/.env on the server, which
# ai1-worker loads via env_file. ai2-service does not: compose.prod.yml resets its
# env_file, so it only receives the keys listed under its environment: there.

# ---- Monitoring (/admin/monitoring → backend /grafana → Grafana → Prometheus) ----
# Signs the short-lived /grafana cookie of the admin page.
MONITORING_SESSION_SECRET=generate
# Grafana's own server admin. The login form and basic auth are off, so this
# account is for emergencies only (docker exec); dashboards come from git.
GRAFANA_ADMIN_PASSWORD=generate
# "none" while the frontend runs on another site than API_HOST (localhost:5173);
# "lax" once both are under one registrable domain (app.x.com + api.x.com).
MONITORING_COOKIE_SAMESITE=none
GRAFANA_DASHBOARD_UID=ci-overview
PROMETHEUS_RETENTION_TIME=15d
PROMETHEUS_RETENTION_SIZE=5GB

# ---- Mail (optional). Empty = mailpit, reachable only through an SSH tunnel ----
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=lexis@localhost
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
# Invite bounces ("Address not found") are read from the sending mailbox over IMAP.
# Empty host = imap.gmail.com when SMTP_HOST=smtp.gmail.com, otherwise not checked.
# Empty user/password = SMTP_USER/SMTP_PASSWORD (a Gmail app password works for both).
# false = never read the mailbox (invite status stays null). A refused login is
# retried after 1 hour, so a wrong password does not lock the sending account.
INVITE_BOUNCE_CHECK_ENABLED=true
INVITE_BOUNCE_IMAP_HOST=
INVITE_BOUNCE_IMAP_PORT=993
INVITE_BOUNCE_IMAP_USER=
INVITE_BOUNCE_IMAP_PASSWORD=
# Seconds without a bounce before an invite counts as delivered (60-86400).
INVITE_BOUNCE_PENDING_SECONDS=600

# ---- Service logs (journald, deploy/compose.prod.yml) ----
# Logs of backend, workers, AI2, Keycloak, Kafka, MinIO, Caddy and frontend are
# kept by journald across deploys and reboots. Empty = 2G total, 30 days.
LOG_JOURNAL_MAX_USE=
LOG_RETENTION_DAYS=

# ---- Nightly backup (deploy/backup.sh) ----
# deploy.sh writes /etc/cron.d/ci-backup from this cron expression, in the
# server's clock (UTC on AWS). Empty = 0 19 * * * (02:00 in Vietnam); "off" removes it.
BACKUP_SCHEDULE=
# Days a local backup in /var/backups/contract-intelligence is kept. Empty = 3.
# Each backup holds both databases and every MinIO file: check `df -h /`.
BACKUP_KEEP_DAYS=

# ---- Off-site backup (optional). Empty BACKUP_S3_ENDPOINT = local backups only ----
# Production: AWS S3 bucket ci-backups-706421610602 (ap-southeast-2), endpoint
# https://s3.ap-southeast-2.amazonaws.com, BACKUP_REMOTE_KEEP_DAYS=0 (deploy/README.md).
# deploy/backup.sh encrypts each night's backup and copies it to an
# S3-compatible bucket (deploy/README.md, "Backup ra ngoài máy").
# Supabase Storage: https://<project-ref>.supabase.co/storage/v1/s3, the
# project's region, and an S3 access key from the Storage settings.
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# At least 20 characters. Keep a copy OFF this server: without it the off-site
# backups cannot be read, and it is lost with the server otherwise.
BACKUP_ENCRYPTION_PASSPHRASE=
# Largest part uploaded; keep it under the bucket's per-file limit.
BACKUP_PART_SIZE=45M
# Days an off-site backup is kept. Empty = same as the local ones (BACKUP_KEEP_DAYS).
# 0 = never delete from this server: the bucket's lifecycle rule expires old
# backups and the key has no delete permission (AWS S3 setup in deploy/README.md).
BACKUP_REMOTE_KEEP_DAYS=

# ---- Sizing ----
# On a server with less than 8 GB of RAM see deploy/README.md, "Máy chủ ít RAM".
# JVM heaps. Empty = the defaults in compose.prod.yml (Kafka -Xmx512m -Xms128m,
# Keycloak -Xms256m -Xmx512m). See deploy/README.md, "Bộ nhớ".
KAFKA_HEAP_OPTS=
KEYCLOAK_HEAP_OPTS=
# IDP jobs AI2 runs at once; backend-worker hands it no more than that and the
# rest wait in the backend. Each one holds a whole dossier in memory: raise
# only with RAM to spare (AI2_MEM_LIMIT).
AI2_MAX_CONCURRENT_JOBS=1
# process: each AI2 job runs in its own child process; an OOM-kill ends that job, not the API (#113).
AI2_JOB_ISOLATION=process
# Per-container memory caps (docker-compose.yml has the full list). A service
# that passes its cap swaps, then restarts, instead of starving the others.
# 2g was too small: a 202-page dossier reached the cap and was OOM-killed (#113).
AI2_MEM_LIMIT=3584m
AI1_MEM_LIMIT=1536m
# Largest PDF the backend accepts, in bytes (50 MiB). AI1 refuses sources above
# 50 MiB on its own (MAX_UPLOAD_BYTES in ai-service), so raise both or neither.
UPLOAD_MAX_FILE_BYTES=52428800
# Chunked dossier upload (POST /api/v1/uploads, #145). Cloudflare Free cuts a
# request still sending its body after ~125 s; 1 MiB takes ~30 s at 35 KB/s.
# Sessions not completed within the TTL are deleted with their chunks.
UPLOAD_CHUNK_BYTES=1048576
UPLOAD_SESSION_TTL_SECONDS=86400
UPLOAD_SESSIONS_PER_USER=3
LOG_LEVEL=INFO
