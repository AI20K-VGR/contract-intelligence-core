# Public entry point. Caddy obtains and renews Let's Encrypt certificates for
# both hosts (sslip.io names resolve to the VPS IP, so no DNS setup is needed).

(common) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	log {
		output stdout
		format console
	}
}

# Backend API — for the frontend. AI1/AI2 never come through here: AI1 talks
# over Kafka and AI2 over HTTP inside ci-network. /grafana/* also lands on the
# backend, which lets only ADMINISTRATOR through to the internal Grafana;
# Grafana, Prometheus and the exporters have no route of their own.
{$API_HOST} {
	import common

	# A dossier upload holds up to 6 PDFs of 50 MiB each (DEC-BE-AI2-01 D5):
	# 300 MiB plus multipart overhead. Caddy reads "MB" as 10^6 bytes, so the
	# old 300MB refused six full-size files before the backend could answer.
	request_body {
		max_size 320MiB
	}

	reverse_proxy backend:8000 {
		# SSE (/api/v1/runs/{id}/events): pass each event through at once.
		flush_interval -1
		# Grafana auth-proxy headers are set by the backend after its
		# ADMINISTRATOR check, never by a client. The backend drops them too.
		header_up -X-Webauth-User
		header_up -X-Webauth-Role
		header_up -X-Webauth-Name
		header_up -X-Webauth-Email
		header_up -X-Webauth-Groups
	}
}

# Keycloak — login pages, OIDC endpoints and the account console.
{$AUTH_HOST} {
	import common

	# Admin console and admin REST stay off the Internet; operators use an SSH
	# tunnel (deploy/README.md). The backend reaches admin REST internally.
	@admin path /admin /admin/*
	respond @admin 404

	reverse_proxy keycloak:8080
}

# Optional sites mounted by compose overrides (deploy/compose.frontend.yml adds
# the frontend). No file there means no extra site.
import /etc/caddy/sites/*.caddy
