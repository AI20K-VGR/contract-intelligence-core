# Frontend site, imported by deploy/Caddyfile when deploy/compose.frontend.yml
# is in use. The frontend container is a static file server on ci-network.
#
# The SPA calls the API on its own origin: /api/* and /grafana/* go to the
# backend here, like on {$API_HOST}. A cross-origin call with an Authorization
# header costs a CORS preflight first, one more round trip to Cloudflare per
# request (≈0.5 s from Vietnam on the Free plan, measured 19/10). Same origin,
# no preflight. {$API_HOST} stays for dev machines and scripts.
{$APP_HOST} {
	import common

	handle /api/* {
		# A dossier upload holds up to 6 PDFs of 50 MiB each (same as {$API_HOST}).
		request_body {
			max_size 320MiB
		}

		# Keycloak reports ended sessions inside ci-network only (#129).
		@backchannel_logout path /api/v1/auth/backchannel-logout
		respond @backchannel_logout 404

		reverse_proxy backend:8000 {
			# SSE (/api/v1/runs/{id}/events): pass each event through at once.
			flush_interval -1
		}
	}

	handle /grafana/* {
		# Grafana auth-proxy headers are set by the backend after its
		# ADMINISTRATOR check, never by a client. The backend drops them too.
		reverse_proxy backend:8000 {
			flush_interval -1
			header_up -X-Webauth-User
			header_up -X-Webauth-Role
			header_up -X-Webauth-Name
			header_up -X-Webauth-Email
			header_up -X-Webauth-Groups
		}
	}

	handle {
		# What the app may load, and who may frame it. Sources: the app itself
		# (the API and the /grafana iframe are same-origin now), the API host for
		# builds that still point at it, Keycloak (token calls, the silent renew
		# iframe) and Google Fonts. pdf.js runs its worker from /assets and draws
		# page previews from blob: URLs; 'wasm-unsafe-eval' lets pdf.js (6.x) run its
		# WebAssembly image decoders (not JavaScript eval). 'unsafe-inline' for styles
		# only: components set style attributes. No inline or remote scripts.
		# Only the SPA gets this policy: Grafana is served without it, as on {$API_HOST}.
		header {
			Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https://{$API_HOST} https://{$AUTH_HOST}; frame-src 'self' https://{$API_HOST} https://{$AUTH_HOST}; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self' https://{$AUTH_HOST}; frame-ancestors 'self'"
			X-Frame-Options "SAMEORIGIN"
			Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		}
		reverse_proxy frontend:80
	}
}
