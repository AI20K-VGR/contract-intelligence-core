{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contractintel.internal/schemas/reocr-request.v1.json",
  "title": "Evidence-backed Re-OCR Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "dossier_id", "source_snapshot_id", "target", "reason_code", "evidence_refs", "artifact_refs", "priority", "route", "idempotency_key", "state"],
  "properties": {
    "schema_version": { "const": "reocr-request.v1" },
    "request_id": { "type": "string", "format": "uuid" },
    "dossier_id": { "type": "string", "format": "uuid" },
    "source_snapshot_id": { "type": "string", "format": "uuid" },
    "target": {
      "type": "object", "additionalProperties": false, "required": ["document_id", "page_numbers", "scope"],
      "properties": {
        "document_id": { "type": "string", "format": "uuid" }, "page_numbers": { "type": "array", "minItems": 1, "maxItems": 2, "items": { "type": "integer", "minimum": 1 }, "uniqueItems": true },
        "scope": { "enum": ["REGION", "PAGE", "PAGE_PAIR"] }, "regions": { "type": "array", "items": { "type": "array", "prefixItems": [{ "type": "number", "minimum": 0, "maximum": 1 }, { "type": "number", "minimum": 0, "maximum": 1 }, { "type": "number", "minimum": 0, "maximum": 1 }, { "type": "number", "minimum": 0, "maximum": 1 }], "items": false } }
      }
    },
    "reason_code": { "enum": ["LOW_QUALITY", "MISSING_GEOMETRY", "CRITICAL_AMBIGUITY", "TABLE_PARSE_FAILURE", "CITATION_BINDING_FAILURE", "CROSS_PAGE_CONTINUATION", "EVIDENCE_DISAGREEMENT"] },
    "evidence_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "artifact_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "priority": { "enum": ["LOW", "NORMAL", "HIGH", "CRITICAL"] },
    "route": { "enum": ["LOCAL_AUTO", "EXTERNAL_REVIEW_REQUIRED"] },
    "allowed_profile_ids": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "attempt_budget": { "type": "integer", "minimum": 1, "maximum": 5, "default": 2 },
    "idempotency_key": { "type": "string", "minLength": 16, "maxLength": 128 },
    "state": { "enum": ["REQUESTED", "VALIDATED", "QUEUED", "RUNNING", "SUCCEEDED", "PARTIAL", "FAILED", "QUARANTINED", "CANCELLED"] }
  }
}
