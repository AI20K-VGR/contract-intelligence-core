{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contractintel.internal/schemas/ai2.be.processing.result.v1.json",
  "title": "AI2 to Backend Processing Result v1",
  "description": "Stable asynchronous AI2 result envelope. Index output remains a proposal until Backend review/publish policy accepts it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "idempotency_key", "attempt", "job_id", "status", "review_state", "input_snapshots", "result", "errors"],
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 240},
    "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["snapshot_id", "snapshot_version", "source_digest", "snapshot_digest"],
      "properties": {
        "snapshot_id": {"$ref": "#/$defs/id"},
        "snapshot_version": {"const": "ai1.snapshot.v1"},
        "source_digest": {"$ref": "#/$defs/sha256"},
        "snapshot_digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "citation": {
      "type": "object", "additionalProperties": false,
      "required": ["citation_id", "node_id", "page_revision_id", "bbox", "bbox_fragments", "text_span", "source_file_id", "page", "page_range", "line_ids", "char_start", "char_end", "breadcrumb", "structure_path", "geometry_available", "source_hash", "quote_sha256", "coordinate_system", "geometry_source", "precision", "validation_status"],
      "properties": {
        "citation_id": {"$ref": "#/$defs/id"}, "node_id": {"type": "string"}, "page_revision_id": {"type": "string"},
        "bbox": {"type": "array", "items": {"type": "number"}}, "bbox_fragments": {"type": "array", "items": {"type": "array", "items": {"type": "number"}}},
        "text_span": {"type": "string"}, "source_file_id": {"type": ["string", "null"]}, "page": {"type": ["integer", "null"]}, "page_range": {"type": "array", "items": {"type": "integer"}}, "line_ids": {"type": "array", "items": {"type": "string"}},
        "char_start": {"type": ["integer", "null"]}, "char_end": {"type": ["integer", "null"]}, "breadcrumb": {"type": "array", "items": {"type": "string"}}, "structure_path": {"type": ["string", "null"]}, "geometry_available": {"type": "boolean"},
        "source_hash": {"type": ["string", "null"]}, "quote_sha256": {"type": ["string", "null"]}, "coordinate_system": {"type": ["string", "null"]}, "geometry_source": {"type": ["string", "null"]}, "precision": {"type": ["string", "null"]}, "validation_status": {"type": "string"},
        "table_id": {"type": ["string", "null"]}, "cell_id": {"type": ["string", "null"]}
      }
    },
    "fact": {
      "type": "object", "additionalProperties": false,
      "required": ["fact_id", "raw_value", "normalized_value", "subject", "role", "unit", "currency", "vat_basis", "condition", "scope", "validity", "item_key", "tax_basis", "period_start", "source_role", "provenance", "review_state", "citation_ids"],
      "properties": {
        "fact_id": {"type": "string"}, "raw_value": {"type": "string"}, "normalized_value": {"type": ["string", "null"]}, "subject": {"type": ["string", "null"]}, "role": {"type": ["string", "null"]}, "unit": {"type": ["string", "null"]}, "currency": {"type": ["string", "null"]}, "vat_basis": {"type": ["string", "null"]}, "condition": {"type": ["string", "null"]}, "scope": {"type": ["string", "null"]}, "validity": {"type": ["string", "null"]}, "item_key": {"type": ["string", "null"]}, "tax_basis": {"type": ["string", "null"]}, "period_start": {"type": ["string", "null"]}, "source_role": {"type": ["string", "null"]}, "provenance": {"type": "string"}, "review_state": {"type": "string"}, "citation_ids": {"type": "array", "items": {"type": "string"}}
      }
    },
    "finding": {
      "type": "object", "additionalProperties": false,
      "required": ["finding_id", "left_id", "right_id", "finding_type", "model_disposition", "review_state", "evidence_left_citation_ids", "evidence_right_citation_ids", "reason", "disposition", "scope", "item_key"],
      "properties": {
        "finding_id": {"type": "string"}, "left_id": {"type": "string"}, "right_id": {"type": "string"}, "finding_type": {"type": "string"}, "model_disposition": {"type": "string"}, "review_state": {"type": "string"}, "evidence_left_citation_ids": {"type": "array", "items": {"type": "string"}}, "evidence_right_citation_ids": {"type": "array", "items": {"type": "string"}}, "reason": {"type": "string"}, "disposition": {"type": ["string", "null"]}, "scope": {"type": ["string", "null"]}, "item_key": {"type": ["string", "null"]}
      }
    },
    "context_finding": {
      "type": "object", "additionalProperties": false,
      "required": ["finding_id", "finding_type", "relation_type", "subject_key", "source_node_ids", "review_state", "reason", "citation_ids", "metadata"],
      "properties": {
        "finding_id": {"type": "string"}, "finding_type": {"type": "string"}, "relation_type": {"type": ["string", "null"]}, "subject_key": {"type": ["string", "null"]},
        "source_node_ids": {"type": "array", "items": {"type": "string"}}, "review_state": {"type": "string"}, "reason": {"type": "string"},
        "citation_ids": {"type": "array", "items": {"type": "string"}}, "metadata": {"type": "object"}
      }
    },
    "error": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {"code": {"type": "string"}, "message": {"type": "string"}, "retryable": {"type": "boolean"}}
    },
    "result": {
      "type": "object", "additionalProperties": false,
      "required": ["facts", "findings", "citations", "index_contribution"],
      "properties": {
        "facts": {"type": "array", "items": {"$ref": "#/$defs/fact"}},
        "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
        "context_findings": {"type": "array", "items": {"$ref": "#/$defs/context_finding"}},
        "events": {"type": "array", "items": {"type": "object"}},
        "citations": {"type": "array", "items": {"$ref": "#/$defs/citation"}},
        "index_contribution": {
          "type": "object", "additionalProperties": false,
          "required": ["state", "chunks", "evidence_issues", "coverage", "extraction_version", "proposed_index_version"],
          "properties": {"state": {"const": "propose"}, "chunks": {"type": "array", "items": {"type": "object"}}, "evidence_issues": {"type": "array", "items": {"type": "object"}}, "coverage": {"type": "object"}, "extraction_version": {"type": "integer"}, "proposed_index_version": {"type": "string"}, "contract_context": {"anyOf": [{"type": "object"}, {"type": "null"}]}
          }
        }
      }
    }
  },
  "properties": {
    "schema_version": {"const": "ai2.be.processing.result.v1"}, "request_id": {"$ref": "#/$defs/id"}, "idempotency_key": {"$ref": "#/$defs/id"}, "attempt": {"type": "integer", "minimum": 1}, "job_id": {"$ref": "#/$defs/id"},
    "status": {"enum": ["QUEUED", "RUNNING", "SUCCEEDED", "FAILED"]}, "review_state": {"anyOf": [{"enum": ["PASS", "NEEDS_REVIEW", "INSUFFICIENT_EVIDENCE", "BLOCKED"]}, {"type": "null"}]},
    "input_snapshots": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/identity"}}, "result": {"anyOf": [{"$ref": "#/$defs/result"}, {"type": "null"}]}, "errors": {"type": "array", "items": {"$ref": "#/$defs/error"}}
  }
}
