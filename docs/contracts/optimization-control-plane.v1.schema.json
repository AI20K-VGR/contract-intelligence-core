{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contractintel.internal/schemas/optimization-control-plane.v1.json",
  "title": "Optimization Control Plane v1",
  "oneOf": [
    { "$ref": "#/$defs/configBundle" },
    { "$ref": "#/$defs/candidatePatch" },
    { "$ref": "#/$defs/evaluationPlan" }
  ],
  "$defs": {
    "uuid": { "type": "string", "format": "uuid" },
    "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
    "configBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "schema_version", "parent_config_bundle_id", "components", "policy_version"],
      "properties": {
        "kind": { "const": "config_bundle" },
        "schema_version": { "const": "optimization.control-plane.v1" },
        "parent_config_bundle_id": { "anyOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }] },
        "policy_version": { "$ref": "#/$defs/uuid" },
        "components": {
          "type": "object",
          "additionalProperties": false,
          "required": ["render", "preprocess", "ocr_layout", "idp_rules", "routing"],
          "properties": {
            "render": { "$ref": "#/$defs/component" },
            "preprocess": { "$ref": "#/$defs/component" },
            "ocr_layout": { "$ref": "#/$defs/component" },
            "idp_rules": { "$ref": "#/$defs/component" },
            "routing": { "$ref": "#/$defs/component" },
            "semantic": { "$ref": "#/$defs/component" }
          }
        },
        "code_image_digest": { "$ref": "#/$defs/sha256" },
        "dependency_lock_digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "artifact_digest", "parameters"],
      "properties": {
        "artifact_id": { "$ref": "#/$defs/uuid" },
        "artifact_digest": { "$ref": "#/$defs/sha256" },
        "parameters": {
          "type": "object",
          "additionalProperties": { "type": ["string", "number", "boolean", "null"] }
        }
      }
    },
    "candidatePatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "schema_version", "base_config_bundle_id", "allowed_knob_set_id", "changes", "hypothesis"],
      "properties": {
        "kind": { "const": "candidate_patch" },
        "schema_version": { "const": "optimization.control-plane.v1" },
        "base_config_bundle_id": { "$ref": "#/$defs/uuid" },
        "allowed_knob_set_id": { "$ref": "#/$defs/uuid" },
        "hypothesis": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "changes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "value"],
            "properties": {
              "path": { "type": "string", "pattern": "^/(render|preprocess|ocr_layout|idp_rules|routing|semantic)/[A-Za-z0-9._-]+$" },
              "value": { "type": ["string", "number", "boolean", "null"] }
            }
          }
        }
      }
    },
    "evaluationPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "schema_version", "dataset_version_id", "split", "primary_metric", "guardrail_metric_ids"],
      "properties": {
        "kind": { "const": "evaluation_plan" },
        "schema_version": { "const": "optimization.control-plane.v1" },
        "dataset_version_id": { "$ref": "#/$defs/uuid" },
        "split": { "enum": ["DEV", "SEALED_HOLDOUT"] },
        "primary_metric": { "type": "string" },
        "guardrail_metric_ids": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
        "strata": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    }
  }
}
