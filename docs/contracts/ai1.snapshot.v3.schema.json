{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contractintel.internal/schemas/ai1.snapshot.v3.json",
  "title": "AI1 OCR/Layout Snapshot v3",
  "description": "Immutable OCR/layout snapshot in Canonical Page Space (CPS). Machine geometry is never a human overlay.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "snapshot_id", "dossier_id", "document_id", "run_id", "source_digest", "created_at", "execution", "producer", "language", "status", "pages"],
  "properties": {
    "schema_version": {"const": "ai1.snapshot.v3"},
    "snapshot_id": {"$ref": "#/$defs/uuid"},
    "parent_snapshot_id": {"type": ["string", "null"], "format": "uuid"},
    "dossier_id": {"$ref": "#/$defs/uuid"}, "document_id": {"$ref": "#/$defs/uuid"}, "run_id": {"$ref": "#/$defs/uuid"},
    "source_digest": {"$ref": "#/$defs/sha256"}, "created_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["SUCCESS", "PARTIAL", "FAILED"]},
    "execution": {"$ref": "#/$defs/execution"}, "producer": {"$ref": "#/$defs/producer"}, "language": {"$ref": "#/$defs/language"},
    "reocr": {"$ref": "#/$defs/reocr"},
    "pages": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/page"}}
  },
  "allOf": [
    {"if": {"required": ["parent_snapshot_id"], "properties": {"parent_snapshot_id": {"type": "string"}}}, "then": {"required": ["reocr"]}},
    {"if": {"required": ["reocr"]}, "then": {"required": ["parent_snapshot_id"], "properties": {"parent_snapshot_id": {"type": "string"}}}}
  ],
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "uuid": {"type": "string", "format": "uuid"}, "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "bbox": {"type": "array", "prefixItems": [{"type": "number", "minimum": 0, "maximum": 1}, {"type": "number", "minimum": 0, "maximum": 1}, {"type": "number", "minimum": 0, "maximum": 1}, {"type": "number", "minimum": 0, "maximum": 1}], "items": false, "description": "[x0,y0,x1,y1]; semantic validator enforces x1>x0 and y1>y0."},
    "execution": {"type": "object", "additionalProperties": false, "required": ["execution_manifest_id", "config_bundle_id", "config_digest", "policy_digest", "source_version_digest"], "properties": {"execution_manifest_id": {"$ref": "#/$defs/uuid"}, "config_bundle_id": {"$ref": "#/$defs/uuid"}, "config_digest": {"$ref": "#/$defs/sha256"}, "policy_digest": {"$ref": "#/$defs/sha256"}, "source_version_digest": {"$ref": "#/$defs/sha256"}, "replay": {"type": "boolean"}}},
    "producer": {"type": "object", "additionalProperties": false, "required": ["engine_name", "engine_version", "code_image_digest", "config_digest"], "properties": {"engine_name": {"type": "string", "minLength": 1}, "engine_version": {"type": "string", "minLength": 1}, "model_version": {"type": "string"}, "prompt_version": {"type": "string"}, "preprocess_version": {"type": "string"}, "code_image_digest": {"$ref": "#/$defs/sha256"}, "config_digest": {"$ref": "#/$defs/sha256"}}},
    "language": {"type": "object", "additionalProperties": false, "required": ["declared_scope", "detected_profile", "detector"], "properties": {"declared_scope": {"enum": ["vi", "en", "vi-en", "unknown"]}, "detected_profile": {"enum": ["vi", "en", "vi-en", "unknown"]}, "detector": {"type": "object", "additionalProperties": false, "required": ["name", "version"], "properties": {"name": {"type": "string"}, "version": {"type": "string"}, "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1}}}}},
    "reocr": {"type": "object", "additionalProperties": false, "required": ["request_id", "revision_scope", "attempt_no", "parent_page_revision_ids"], "properties": {"request_id": {"$ref": "#/$defs/uuid"}, "revision_scope": {"enum": ["REGION", "PAGE", "PAGE_PAIR"]}, "attempt_no": {"type": "integer", "minimum": 1}, "profile_id": {"type": "string"}, "parent_page_revision_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/uuid"}, "uniqueItems": true}}},
    "warning": {"type": "object", "additionalProperties": false, "required": ["code"], "properties": {"code": {"type": "string", "minLength": 1}, "message": {"type": "string"}, "line_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true}}},
    "word": {"type": "object", "additionalProperties": false, "required": ["word_id", "text", "char_start", "char_end", "bbox_source", "geometry_status"], "properties": {"word_id": {"$ref": "#/$defs/id"}, "text": {"type": "string", "minLength": 1}, "char_start": {"type": "integer", "minimum": 0}, "char_end": {"type": "integer", "minimum": 1}, "bbox": {"type": ["array", "null"], "items": {"type": "number"}}, "bbox_source": {"enum": ["native", "detector", "derived", "absent"]}, "geometry_status": {"enum": ["measured", "derived", "absent"]}, "engine_confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1}}, "allOf": [{"if": {"properties": {"bbox_source": {"enum": ["native", "detector"]}}}, "then": {"required": ["bbox"], "properties": {"bbox": {"$ref": "#/$defs/bbox"}, "geometry_status": {"const": "measured"}}}}, {"if": {"properties": {"bbox_source": {"const": "derived"}}}, "then": {"required": ["bbox"], "properties": {"bbox": {"$ref": "#/$defs/bbox"}, "geometry_status": {"const": "derived"}}}}, {"if": {"properties": {"bbox_source": {"const": "absent"}}}, "then": {"properties": {"bbox": {"type": "null"}, "geometry_status": {"const": "absent"}}}}]},
    "line": {"type": "object", "additionalProperties": false, "required": ["line_id", "raw_text", "bbox_source", "geometry_status", "words"], "properties": {"line_id": {"$ref": "#/$defs/id"}, "raw_text": {"type": "string"}, "bbox": {"type": ["array", "null"], "items": {"type": "number"}}, "bbox_source": {"enum": ["native", "detector", "derived", "line_only", "absent"]}, "geometry_status": {"enum": ["measured", "line_only", "derived", "absent"]}, "engine_confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1}, "words": {"type": "array", "items": {"$ref": "#/$defs/word"}}}, "allOf": [{"if": {"properties": {"bbox_source": {"enum": ["native", "detector"]}}}, "then": {"required": ["bbox"], "properties": {"bbox": {"$ref": "#/$defs/bbox"}, "geometry_status": {"const": "measured"}}}}, {"if": {"properties": {"bbox_source": {"const": "line_only"}}}, "then": {"required": ["bbox"], "properties": {"bbox": {"$ref": "#/$defs/bbox"}, "geometry_status": {"const": "line_only"}}}}, {"if": {"properties": {"bbox_source": {"const": "derived"}}}, "then": {"required": ["bbox"], "properties": {"bbox": {"$ref": "#/$defs/bbox"}, "geometry_status": {"const": "derived"}}}}, {"if": {"properties": {"bbox_source": {"const": "absent"}}}, "then": {"properties": {"bbox": {"type": "null"}, "geometry_status": {"const": "absent"}}}}]},
    "cell": {"type": "object", "additionalProperties": false, "required": ["cell_id", "row_index", "column_index", "text", "bbox", "bbox_source", "geometry_status", "line_ids"], "properties": {"cell_id": {"$ref": "#/$defs/id"}, "row_index": {"type": "integer", "minimum": 0}, "column_index": {"type": "integer", "minimum": 0}, "rowspan": {"type": "integer", "minimum": 1}, "colspan": {"type": "integer", "minimum": 1}, "text": {"type": "string"}, "bbox": {"$ref": "#/$defs/bbox"}, "bbox_source": {"enum": ["native", "detector", "derived", "line_only"]}, "geometry_status": {"enum": ["measured", "derived", "line_only"]}, "line_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}, "uniqueItems": true}}, "allOf": [{"if": {"properties": {"bbox_source": {"enum": ["native", "detector"]}}}, "then": {"properties": {"geometry_status": {"const": "measured"}}}}, {"if": {"properties": {"bbox_source": {"const": "derived"}}}, "then": {"properties": {"geometry_status": {"const": "derived"}}}}, {"if": {"properties": {"bbox_source": {"const": "line_only"}}}, "then": {"properties": {"geometry_status": {"const": "line_only"}}}}]},
    "table": {"type": "object", "additionalProperties": false, "required": ["table_id", "bbox", "bbox_source", "geometry_status", "cells"], "properties": {"table_id": {"$ref": "#/$defs/id"}, "bbox": {"$ref": "#/$defs/bbox"}, "bbox_source": {"enum": ["native", "detector", "derived", "line_only"]}, "geometry_status": {"enum": ["measured", "derived", "line_only"]}, "cells": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/cell"}}}, "allOf": [{"if": {"properties": {"bbox_source": {"enum": ["native", "detector"]}}}, "then": {"properties": {"geometry_status": {"const": "measured"}}}}, {"if": {"properties": {"bbox_source": {"const": "derived"}}}, "then": {"properties": {"geometry_status": {"const": "derived"}}}}, {"if": {"properties": {"bbox_source": {"const": "line_only"}}}, "then": {"properties": {"geometry_status": {"const": "line_only"}}}}]},
    "page": {"type": "object", "additionalProperties": false, "required": ["page_no", "page_revision_id", "input_type", "status", "raw_text_digest", "render", "transform", "quality", "lines", "tables", "warnings"], "properties": {"page_no": {"type": "integer", "minimum": 1}, "page_revision_id": {"$ref": "#/$defs/uuid"}, "reused_from_snapshot_id": {"type": "string", "format": "uuid"}, "input_type": {"enum": ["TEXT_LAYER", "SCANNED_OCR", "MIXED"]}, "status": {"enum": ["SUCCESS", "PARTIAL", "FAILED"]}, "raw_text_digest": {"$ref": "#/$defs/sha256"}, "page_language_override": {"enum": ["vi", "en", "vi-en", "unknown"]}, "render": {"type": "object", "additionalProperties": false, "required": ["uri", "digest", "width_px", "height_px"], "properties": {"uri": {"type": "string", "pattern": "^(object|storage)://"}, "digest": {"$ref": "#/$defs/sha256"}, "width_px": {"type": "integer", "minimum": 1}, "height_px": {"type": "integer", "minimum": 1}}}, "transform": {"type": "object", "additionalProperties": false, "required": ["rotation_degrees", "profile_version"], "properties": {"rotation_degrees": {"enum": [0, 90, 180, 270]}, "profile_version": {"type": "string", "minLength": 1}, "matrix": {"type": "array", "items": {"type": "number"}, "minItems": 6, "maxItems": 9}}}, "quality": {"type": "object", "additionalProperties": false, "required": ["coverage_status"], "properties": {"coverage_status": {"enum": ["COMPLETE", "NEEDS_REVIEW", "FAILED"]}, "ocr_confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1}, "alignment_score": {"type": ["number", "null"], "minimum": 0, "maximum": 1}}}, "lines": {"type": "array", "items": {"$ref": "#/$defs/line"}}, "tables": {"type": "array", "items": {"$ref": "#/$defs/table"}}, "warnings": {"type": "array", "items": {"$ref": "#/$defs/warning"}}, "error": {"$ref": "#/$defs/warning"}}}
  }
}
