{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contractintel.internal/schemas/ai2.contract-type-profile.v1.json",
  "title": "AI2 Contract Type Profile v1",
  "description": "Versioned field vocabulary for the first AI2 contract-type wave; raw evidence remains authoritative.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_type", "version", "fields", "aliases", "annex_extensions"],
  "properties": {
    "schema_version": {"const": "ai2.contract-type-profile.v1"},
    "contract_type": {"enum": ["SALES", "SUPPLY_SERVICE", "LEASE", "CONSTRUCTION_WORK", "EMPLOYMENT", "NDA"]},
    "version": {"type": "integer", "minimum": 1},
    "fields": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/field"}},
    "aliases": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string", "minLength": 1}},
    "annex_extensions": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/annex"}}
  },
  "$defs": {
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "aliases", "value_type", "normalization", "evidence_policy"],
      "properties": {
        "key": {"type": "string", "minLength": 1, "maxLength": 120},
        "aliases": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string", "minLength": 1}},
        "value_type": {"type": "string", "minLength": 1, "maxLength": 40},
        "normalization": {"type": "string", "minLength": 1, "maxLength": 120},
        "evidence_policy": {"type": "string", "minLength": 1, "maxLength": 120}
      }
    },
    "annex": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "aliases", "field_keys"],
      "properties": {
        "key": {"type": "string", "minLength": 1, "maxLength": 120},
        "aliases": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string", "minLength": 1}},
        "field_keys": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
