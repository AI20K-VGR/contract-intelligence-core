{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contractintel.internal/schemas/ai1.snapshot.v1.json",
  "title": "AI1 OCR/Layout Snapshot v1",
  "description": "Evidence-first AI1 handoff. Missing geometry or table structure is explicit and never inferred by AI2.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_id",
    "dossier_id",
    "document_id",
    "run_id",
    "source_digest",
    "created_at",
    "execution",
    "producer",
    "language",
    "status",
    "pages"
  ],
  "properties": {
    "schema_version": {"const": "ai1.snapshot.v1"},
    "snapshot_id": {"$ref": "#/$defs/id"},
    "parent_snapshot_id": {"$ref": "#/$defs/id"},
    "dossier_id": {"$ref": "#/$defs/id"},
    "document_id": {"$ref": "#/$defs/id"},
    "run_id": {"$ref": "#/$defs/id"},
    "source_digest": {"$ref": "#/$defs/sha256"},
    "created_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["SUCCESS", "PARTIAL", "FAILED"]},
    "execution": {"$ref": "#/$defs/execution"},
    "producer": {"$ref": "#/$defs/producer"},
    "language": {"$ref": "#/$defs/language"},
    "pages": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/page"}}
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "bbox": {
      "type": "array",
      "prefixItems": [
        {"type": "number", "minimum": 0, "maximum": 1},
        {"type": "number", "minimum": 0, "maximum": 1},
        {"type": "number", "minimum": 0, "maximum": 1},
        {"type": "number", "minimum": 0, "maximum": 1}
      ],
      "items": false
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["execution_manifest_id", "config_digest", "policy_digest", "source_version_digest"],
      "properties": {
        "execution_manifest_id": {"$ref": "#/$defs/id"},
        "config_digest": {"$ref": "#/$defs/sha256"},
        "policy_digest": {"$ref": "#/$defs/sha256"},
        "source_version_digest": {"$ref": "#/$defs/sha256"},
        "replay": {"type": "boolean"}
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine_name", "engine_version", "code_image_digest"],
      "properties": {
        "engine_name": {"type": "string", "minLength": 1},
        "engine_version": {"type": "string", "minLength": 1},
        "model_version": {"type": "string"},
        "preprocess_version": {"type": "string"},
        "code_image_digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "language": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declared_scope", "detected_profile", "detector"],
      "properties": {
        "declared_scope": {"enum": ["vi", "en", "vi-en", "unknown"]},
        "detected_profile": {"enum": ["vi", "en", "vi-en", "unknown"]},
        "detector": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {"name": {"type": "string"}, "version": {"type": "string"}}
        }
      }
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string"},
        "line_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}}
      }
    },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bbox_source", "geometry_status"],
      "properties": {
        "bbox": {"anyOf": [{"$ref": "#/$defs/bbox"}, {"type": "null"}]},
        "bbox_source": {"enum": ["native", "detector", "derived", "line_only", "absent"]},
        "geometry_status": {"enum": ["measured", "derived", "line_only", "absent"]}
      }
    },
    "word": {
      "type": "object",
      "additionalProperties": false,
      "required": ["word_id", "text", "char_start", "char_end", "bbox_source", "geometry_status"],
      "properties": {
        "word_id": {"$ref": "#/$defs/id"},
        "text": {"type": "string", "minLength": 1},
        "char_start": {"type": "integer", "minimum": 0},
        "char_end": {"type": "integer", "minimum": 1},
        "bbox": {"anyOf": [{"$ref": "#/$defs/bbox"}, {"type": "null"}]},
        "bbox_source": {"enum": ["native", "detector", "derived", "absent"]},
        "geometry_status": {"enum": ["measured", "derived", "absent"]},
        "engine_confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
      }
    },
    "line": {
      "type": "object",
      "additionalProperties": false,
      "required": ["line_id", "raw_text", "bbox_source", "geometry_status", "words"],
      "properties": {
        "line_id": {"$ref": "#/$defs/id"},
        "raw_text": {"type": "string"},
        "bbox": {"anyOf": [{"$ref": "#/$defs/bbox"}, {"type": "null"}]},
        "bbox_source": {"enum": ["native", "detector", "derived", "line_only", "absent"]},
        "geometry_status": {"enum": ["measured", "derived", "line_only", "absent"]},
        "engine_confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "words": {"type": "array", "items": {"$ref": "#/$defs/word"}}
      }
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cell_id", "row_index", "column_index", "text", "line_ids", "bbox_fragments"],
      "properties": {
        "cell_id": {"$ref": "#/$defs/id"},
        "row_index": {"type": "integer", "minimum": 0},
        "column_index": {"type": "integer", "minimum": 0},
        "rowspan": {"type": "integer", "minimum": 1},
        "colspan": {"type": "integer", "minimum": 1},
        "row_kind": {"enum": ["HEADER", "DATA", "SUBTOTAL", "TOTAL", "FOOTNOTE", "UNKNOWN"]},
        "text": {"type": "string"},
        "bbox_fragments": {"type": "array", "items": {"$ref": "#/$defs/bbox"}},
        "line_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true}
      }
    },
    "table_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "method"],
      "properties": {
        "status": {"enum": ["NOT_PRESENT", "DETECTED", "UNKNOWN", "UNAVAILABLE", "FAILED"]},
        "method": {"type": "string", "minLength": 1},
        "version": {"type": "string"}
      }
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": ["table_id", "table_coverage", "cells"],
      "properties": {
        "table_id": {"$ref": "#/$defs/id"},
        "logical_table_id": {"$ref": "#/$defs/id"},
        "fragment_id": {"$ref": "#/$defs/id"},
        "continuation": {"type": "boolean"},
        "table_coverage": {"$ref": "#/$defs/table_coverage"},
        "bbox": {"anyOf": [{"$ref": "#/$defs/bbox"}, {"type": "null"}]},
        "geometry_status": {"enum": ["measured", "derived", "line_only", "absent"]},
        "cells": {"type": "array", "items": {"$ref": "#/$defs/cell"}}
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coverage_status"],
      "properties": {
        "coverage_status": {"enum": ["COMPLETE", "BLANK_VERIFIED", "NEEDS_REVIEW", "FAILED"]},
        "ocr_confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "signals": {"type": "array", "items": {"type": "string"}}
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "page_no",
        "page_revision_id",
        "input_type",
        "status",
        "raw_text_digest",
        "transform",
        "quality",
        "table_coverage",
        "lines",
        "tables",
        "warnings"
      ],
      "properties": {
        "page_no": {"type": "integer", "minimum": 1},
        "page_revision_id": {"$ref": "#/$defs/id"},
        "input_type": {"enum": ["TEXT_LAYER", "SCANNED_OCR", "MIXED"]},
        "status": {"enum": ["SUCCESS", "PARTIAL", "FAILED"]},
        "raw_text_digest": {"$ref": "#/$defs/sha256"},
        "transform": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rotation_degrees", "profile_version"],
          "properties": {
            "rotation_degrees": {"enum": [0, 90, 180, 270]},
            "profile_version": {"type": "string", "minLength": 1}
          }
        },
        "quality": {"$ref": "#/$defs/quality"},
        "table_coverage": {"$ref": "#/$defs/table_coverage"},
        "lines": {"type": "array", "items": {"$ref": "#/$defs/line"}},
        "tables": {"type": "array", "items": {"$ref": "#/$defs/table"}},
        "warnings": {"type": "array", "items": {"$ref": "#/$defs/warning"}},
        "error": {"$ref": "#/$defs/warning"}
      }
    }
  }
}
