{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contractintel.internal/schemas/be.ai2.processing.request.v1.json",
  "title": "Backend to AI2 Processing Request v1",
  "description": "Backend-authorized asynchronous processing request containing the complete dossier snapshot set.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "service_envelope",
    "request_id",
    "idempotency_key",
    "attempt",
    "task_id",
    "dossier_id",
    "snapshots",
    "snapshot_identities",
    "dossier_members",
    "role_relation_map",
    "policy_flags"
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_id",
        "snapshot_version",
        "source_digest",
        "snapshot_digest"
      ],
      "properties": {
        "snapshot_id": {
          "$ref": "#/$defs/id"
        },
        "snapshot_version": {
          "const": "ai1.snapshot.v1"
        },
        "source_digest": {
          "$ref": "#/$defs/sha256"
        },
        "snapshot_digest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "member_id",
        "document_id",
        "snapshot_id",
        "role",
        "source_digest"
      ],
      "properties": {
        "member_id": {
          "$ref": "#/$defs/id"
        },
        "document_id": {
          "$ref": "#/$defs/id"
        },
        "snapshot_id": {
          "$ref": "#/$defs/id"
        },
        "role": {
          "enum": [
            "body",
            "annex"
          ]
        },
        "source_digest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relation_id",
        "relation_type",
        "member_id",
        "dossier_id"
      ],
      "properties": {
        "relation_id": {
          "$ref": "#/$defs/id"
        },
        "relation_type": {
          "enum": [
            "MEMBER_OF",
            "ANNEX_OF"
          ]
        },
        "member_id": {
          "$ref": "#/$defs/id"
        },
        "related_member_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "dossier_id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_processing_seconds",
        "max_llm_calls",
        "max_embedding_tokens"
      ],
      "properties": {
        "max_processing_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "max_llm_calls": {
          "type": "integer",
          "minimum": 0
        },
        "max_embedding_tokens": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "budget_limits"
      ],
      "properties": {
        "egress_allowed": {
          "type": "boolean",
          "description": "Advisory only; AI2 decides egress from AI2_PROCESSING_EGRESS_ALLOWED. Optional, default false."
        },
        "use_vector": {
          "type": "boolean",
          "description": "Optional, default false."
        },
        "budget_limits": {
          "$ref": "#/$defs/budget"
        }
      }
    },
    "ContextBounds": {
      "additionalProperties": false,
      "properties": {
        "max_hops": {
          "maximum": 8,
          "minimum": 0,
          "title": "Max Hops",
          "type": "integer"
        },
        "max_nodes": {
          "maximum": 256,
          "minimum": 1,
          "title": "Max Nodes",
          "type": "integer"
        },
        "max_context_tokens": {
          "maximum": 32768,
          "minimum": 1,
          "title": "Max Context Tokens",
          "type": "integer"
        },
        "max_output_tokens": {
          "maximum": 8192,
          "minimum": 1,
          "title": "Max Output Tokens",
          "type": "integer"
        },
        "max_llm_calls": {
          "maximum": 20,
          "minimum": 0,
          "title": "Max Llm Calls",
          "type": "integer"
        },
        "max_seconds": {
          "maximum": 300,
          "minimum": 1,
          "title": "Max Seconds",
          "type": "integer"
        }
      },
      "required": [
        "max_hops",
        "max_nodes",
        "max_context_tokens",
        "max_output_tokens",
        "max_llm_calls",
        "max_seconds"
      ],
      "title": "ContextBounds",
      "type": "object"
    },
    "SemanticAlias": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "title": "Source",
          "type": "string"
        },
        "symbol": {
          "title": "Symbol",
          "type": "string"
        },
        "kind": {
          "enum": [
            "action",
            "qualifier"
          ],
          "title": "Kind",
          "type": "string"
        },
        "proposal_id": {
          "title": "Proposal Id",
          "type": "string"
        }
      },
      "required": [
        "source",
        "symbol",
        "kind",
        "proposal_id"
      ],
      "title": "SemanticAlias",
      "type": "object"
    },
    "semantic_profile": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "ai2.semantic-profile.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "capability": {
          "const": "ai2.semantic.v1",
          "title": "Capability",
          "type": "string"
        },
        "tenant_id": {
          "minLength": 1,
          "title": "Tenant Id",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "contract_type": {
          "enum": [
            "SALES",
            "SUPPLY_SERVICE",
            "LEASE",
            "CONSTRUCTION_WORK",
            "EMPLOYMENT",
            "NDA"
          ],
          "title": "Contract Type",
          "type": "string"
        },
        "alias_version": {
          "minimum": 0,
          "title": "Alias Version",
          "type": "integer"
        },
        "alias_digest": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Alias Digest"
        },
        "aliases": {
          "items": {
            "$ref": "#/$defs/SemanticAlias"
          },
          "title": "Aliases",
          "type": "array"
        },
        "activation_state": {
          "enum": [
            "ACTIVE",
            "DRAFT_ONLY"
          ],
          "title": "Activation State",
          "type": "string"
        },
        "context_bounds": {
          "$ref": "#/$defs/ContextBounds"
        },
        "alias_proposal_minimum_length": {
          "anyOf": [
            {
              "maximum": 120,
              "minimum": 4,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Alias Proposal Minimum Length"
        }
      },
      "required": [
        "schema_version",
        "capability",
        "tenant_id",
        "version",
        "digest",
        "contract_type",
        "alias_version",
        "activation_state",
        "context_bounds"
      ],
      "title": "SemanticProfile",
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {
      "const": "be.ai2.processing.request.v1"
    },
    "service_envelope": {
      "$ref": "ai2.service-envelope.v1.schema.json"
    },
    "request_id": {
      "$ref": "#/$defs/id"
    },
    "idempotency_key": {
      "$ref": "#/$defs/id"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "task_id": {
      "$ref": "#/$defs/id"
    },
    "dossier_id": {
      "$ref": "#/$defs/id"
    },
    "snapshots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "$ref": "ai1.snapshot.v1.schema.json"
      }
    },
    "snapshot_identities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/identity"
      }
    },
    "dossier_members": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/member"
      },
      "contains": {
        "type": "object",
        "properties": {
          "role": {
            "const": "body"
          }
        },
        "required": [
          "role"
        ]
      },
      "minContains": 1,
      "maxContains": 1
    },
    "role_relation_map": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/relation"
      }
    },
    "policy_flags": {
      "$ref": "#/$defs/policy"
    },
    "semantic_profile": {
      "anyOf": [
        {
          "$ref": "#/$defs/semantic_profile"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
