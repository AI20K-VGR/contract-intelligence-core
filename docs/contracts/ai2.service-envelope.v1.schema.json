{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contractintel.internal/schemas/ai2.service-envelope.v1.json",
  "title": "AI2 Service Envelope v1",
  "description": "Backend authorization and integrity envelope for a canonical AI2 request.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "issuer", "audience", "tenant_id", "actor_id", "dossier_id", "scopes", "key_id", "issued_at", "expires_at", "nonce", "payload_sha256", "signature"],
  "properties": {
    "schema_version": {"const": "ai2.service-envelope.v1"},
    "issuer": {"type": "string", "minLength": 1, "maxLength": 160},
    "audience": {"type": "string", "minLength": 1, "maxLength": 160},
    "tenant_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "actor_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "dossier_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "scopes": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 160}},
    "key_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "issued_at": {"type": "integer", "minimum": 0},
    "expires_at": {"type": "integer", "minimum": 0},
    "nonce": {"type": "string", "minLength": 16, "maxLength": 160},
    "payload_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "signature": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}
  }
}
