{
  "id": "contract-intelligence",
  "enabled": true,
  "displayName": "Contract Intelligence",
  "displayNameHtml": "<div>Contract Intelligence SSO</div>",
  "accessTokenLifespan": 300,
  "accessTokenLifespanForImplicitFlow": 900,
  "ssoSessionIdleTimeout": 1800,
  "accessCodeLifespan": 60,
  "accessCodeLifespanUserAction": 300,
  "sslRequired": "external",
  "registrationAllowed": false,
  "registrationEmailAsUsername": false,
  "rememberMe": true,
  "verifyEmail": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": false,
  "roles": {
    "realm": [
      {
        "name": "OPERATOR",
        "description": "Vận hành nhập liệu và xử lý tài liệu",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "REVIEWER",
        "description": "Thẩm định và xác nhận hồ sơ hợp đồng",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "ADMINISTRATOR",
        "description": "Quản trị hệ thống toàn diện",
        "composite": false,
        "clientRole": false
      }
    ],
    "client": {
      "contract-intel-backend": [
        {
          "name": "OPERATOR",
          "description": "Backend OPERATOR role",
          "composite": false
        },
        {
          "name": "REVIEWER",
          "description": "Backend REVIEWER role",
          "composite": false
        },
        {
          "name": "ADMINISTRATOR",
          "description": "Backend ADMINISTRATOR role",
          "composite": false
        }
      ],
      "contract-intel-frontend": [
        {
          "name": "OPERATOR",
          "description": "Frontend OPERATOR role",
          "composite": false
        },
        {
          "name": "REVIEWER",
          "description": "Frontend REVIEWER role",
          "composite": false
        },
        {
          "name": "ADMINISTRATOR",
          "description": "Frontend ADMINISTRATOR role",
          "composite": false
        }
      ]
    }
  },
  "defaultDefaultClientScopes": [
    "role_list",
    "profile",
    "email"
  ],
  "clients": [
    {
      "id": "contract-intel-backend",
      "clientId": "contract-intel-backend",
      "name": "CI Backend — Resource Server",
      "description": "Backend FastAPI — validates JWT access tokens",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "backend_secret_dev",
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "publicClient": false,
      "frontchannelLogout": false,
      "protocol": "openid-connect",
      "fullScopeAllowed": true,
      "defaultClientScopes": [
        "role_list",
        "profile",
        "email"
      ],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "tenant_id",
            "claim.value": "tenant_vgr_01",
            "userinfo.token.claim": "true",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "access.tokenResponse.claim": "true"
          }
        },
        {
          "name": "ci_role_mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "contract-intel-backend",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "access.tokenResponse.claim": "false"
          }
        }
      ]
    },
    {
      "id": "contract-intel-frontend",
      "clientId": "contract-intel-frontend",
      "name": "Contract Intelligence SPA",
      "description": "React SPA — public OIDC client (Authorization Code + PKCE S256, no client secret)",
      "enabled": true,
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "authorizationServicesEnabled": false,
      "frontchannelLogout": true,
      "protocol": "openid-connect",
      "fullScopeAllowed": true,
      "redirectUris": [
        "http://localhost:5173/auth/callback",
        "http://localhost:5173/auth/silent-callback"
      ],
      "webOrigins": [
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*",
        "oauth2.device.authorization.grant.enabled": "false",
        "oidc.ciba.grant.enabled": "false"
      },
      "defaultClientScopes": [
        "role_list",
        "profile",
        "email",
        "web-origins"
      ],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "realm_roles_mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "realmRoles",
            "claim.name": "realm_access",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "tenant_id_mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "tenant_id",
            "claim.value": "tenant_vgr_01",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
