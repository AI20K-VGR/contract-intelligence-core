# ---------- Contract data: never in the repo (CONTRIBUTING.md) ----------
# Only docs/assets/ may hold images (diagrams, screenshots for documents).
*.pdf
*.doc
*.docx
*.tif
*.tiff
*.jpg
*.jpeg
*.png
*.zip
*.rar
*.7z
!docs/assets/**
data/
samples/
datasets/
# Saved GET /dossiers/{id}/results exports used for local debugging (scripts/
# reconstruct_tables.py) — contain real extracted document text/values.
result*.json

# =====================================================================
# Contract Intelligence - Root .gitignore
# Monorepo: backend (Java/Maven) | frontend (Node) | ai-service (Python)
# =====================================================================

# ---------- OS / Editor ----------
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo
*~

# ---------- Secrets / Local env ----------
.env
.env.local
.env.*.local
*.pem
*.key
secrets/

# ---------- Java / Maven (backend/) ----------
backend/target/
backend/**/target/
backend/**/build/
backend/*.class
backend/**/*.class
backend/*.jar
backend/*.war
backend/*.ear
backend/*.log
backend/.gradle/
backend/dependency-reduced-pom.xml

# Spring Boot
backend/**/*.original

# ---------- Node / Frontend (frontend/) ----------
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.next/
frontend/.nuxt/
frontend/.cache/
frontend/.parcel-cache/
frontend/coverage/
frontend/.env
frontend/.env.*
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/pnpm-debug.log*
frontend/.pnpm-store/

# ---------- Python / AI (ai-service/) ----------
ai-service/__pycache__/
ai-service/**/__pycache__/
ai-service/*.pyc
ai-service/**/*.pyc
ai-service/*.pyo
ai-service/**/*.pyo
ai-service/venv/
ai-service/.venv/
ai-service/env/
ai-service/.env
ai-service/.pytest_cache/
ai-service/.mypy_cache/
ai-service/.ruff_cache/
ai-service/.coverage
ai-service/htmlcov/
ai-service/dist/
ai-service/build/
ai-service/*.egg-info/

# Jupyter
ai-service/.ipynb_checkpoints/

# ML model artifacts (thường quá lớn, mount riêng)
ai-service/models/checkpoints/
ai-service/**/*.h5
ai-service/**/*.pt
ai-service/**/*.pth
ai-service/**/*.onnx

# ---------- Docs / Misc ----------
docs/_site/
docs/.vitepress/cache/

# ---------- Logs ----------
logs/
.cache/
__pycache__/
.venv/
.pytest_cache/
.ruff_cache/
*.pyc
*.egg-info/
apps/web/node_modules/
apps/web/dist/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
