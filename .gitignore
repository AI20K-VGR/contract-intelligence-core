# ---------- Contract data: never in the repo (CONTRIBUTING.md) ----------
# Only docs/assets/ may hold images (diagrams, screenshots for documents).
*.pdf
*.doc
*.docx
*.tif
*.tiff
*.jpg
*.jpeg
*.png
*.zip
*.rar
*.7z
!docs/assets/**
data/
samples/
datasets/

# =====================================================================
# Contract Intelligence - Root .gitignore
# Monorepo: backend (Python/FastAPI) | frontend (Node) | ai-service (Python)
# =====================================================================

# ---------- OS / Editor ----------
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo
*~

# ---------- Secrets / Local env ----------
.env
.env.local
.env.*.local
*.pem
*.key
secrets/
ngrok.yml
ngrok.exe

# ---------- Python (Backend & AI Service) ----------
__pycache__/
*.pyc
*.pyo
*.py[cod]
*$py.class
venv/
.venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.import_linter_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# Jupyter
.ipynb_checkpoints/

# ML model artifacts (thường quá lớn, mount riêng)
ai-service/models/checkpoints/
ai-service/**/*.h5
ai-service/**/*.pt
ai-service/**/*.pth
ai-service/**/*.onnx

# ---------- Node / Frontend (frontend/) ----------
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.next/
frontend/.nuxt/
frontend/.cache/
frontend/.parcel-cache/
frontend/coverage/
frontend/.env
frontend/.env.*
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/pnpm-debug.log*
frontend/.pnpm-store/

# ---------- Docs / Misc ----------
docs/_site/
docs/.vitepress/cache/

# ---------- Logs ----------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
