    "PAY": {"aliases": ["thanh toán", "trả tiền", "chi trả"], "flip_on_passive": true,
            "definition": "trả tiền theo hợp đồng"},
    "ACCEPT": {"aliases": ["nghiệm thu"], "flip_on_passive": false,
               "definition": "kiểm tra và chấp nhận kết quả/hàng hóa"},
    "WARRANT": {"aliases": ["bảo hành", "sửa chữa"], "flip_on_passive": false,
                "definition": "sửa chữa/thay thế trong thời gian bảo hành"},
    "HANDOVER_ASSET": {"aliases": ["bàn giao tài sản", "bàn giao mặt bằng", "bàn giao nhà"], "flip_on_passive": true,
