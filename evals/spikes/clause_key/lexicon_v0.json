    "WARRANTY_PERIOD": ["thời hạn bảo hành", "thời gian bảo hành"],
    "CONFIDENTIALITY_PERIOD": ["thời hạn bảo mật"]
  },
  "stopwords": ["việc", "các", "của", "trong", "đã", "sự", "những", "theo", "cho", "bị", "được", "hợp đồng này"]
}
