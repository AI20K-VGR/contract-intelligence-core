    "RETURN_ASSET": {"aliases": ["hoàn trả tài sản", "trả lại tài sản", "trả mặt bằng"], "flip_on_passive": false,
                     "definition": "trả lại tài sản thuê khi kết thúc"},
    "COMPLETE_WORK": {"aliases": ["hoàn thành công trình", "thi công", "hoàn thành hạng mục"], "flip_on_passive": false,
                      "definition": "hoàn thành công việc/công trình xây dựng"},
    "PROVIDE_SERVICE": {"aliases": ["cung cấp dịch vụ"], "flip_on_passive": false,
                        "definition": "cung cấp dịch vụ theo hợp đồng"},
    "DISCLOSE": {"aliases": ["tiết lộ", "công bố"], "flip_on_passive": false,
                 "definition": "tiết lộ thông tin mật cho bên thứ ba"},
    "WORK": {"aliases": ["làm việc", "đi làm"], "flip_on_passive": false,
             "definition": "người lao động thực hiện công việc"},
    "TERMINATE_EARLY": {"aliases": ["đơn phương chấm dứt", "chấm dứt trước hạn"], "flip_on_passive": false,
                        "definition": "một bên tự chấm dứt hợp đồng trước thời hạn"},
    "ANY_OBLIGATION": {"aliases": ["vi phạm hợp đồng", "vi phạm nghĩa vụ", "vi phạm bất kỳ nghĩa vụ"], "flip_on_passive": false,
                       "definition": "vi phạm nghĩa vụ chung, không chỉ rõ nghĩa vụ nào"}
  },
  "qualifiers": {
