  "counterparty": {
    "SELLER": "BUYER", "BUYER": "SELLER",
    "SUPPLIER": "CUSTOMER", "CUSTOMER": "SUPPLIER",
    "LESSOR": "LESSEE", "LESSEE": "LESSOR",
    "CONTRACTOR": "OWNER", "OWNER": "CONTRACTOR",
    "EMPLOYER": "EMPLOYEE", "EMPLOYEE": "EMPLOYER",
    "DISCLOSER": "RECIPIENT", "RECIPIENT": "DISCLOSER"
  },
  "actions": {
    "DELIVER": {"aliases": ["giao hàng", "giao", "bàn giao hàng hóa", "bàn giao hàng"], "flip_on_passive": true,
