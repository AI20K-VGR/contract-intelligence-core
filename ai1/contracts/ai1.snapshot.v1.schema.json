{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Cell": {
      "additionalProperties": false,
      "properties": {
        "cell_id": {
          "title": "Cell Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "bbox_normalized": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "maxItems": 4,
              "minItems": 4,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bbox Normalized"
        },
        "geometry_provenance": {
          "anyOf": [
            {
              "enum": [
                "MEASURED",
                "DERIVED",
                "CLAIMED"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Geometry Provenance"
        },
        "row_index": {
          "default": 0,
          "minimum": 0,
          "title": "Row Index",
          "type": "integer"
        },
        "column_index": {
          "default": 0,
          "minimum": 0,
          "title": "Column Index",
          "type": "integer"
        },
        "rowspan": {
          "default": 1,
          "minimum": 1,
          "title": "Rowspan",
          "type": "integer"
        },
        "colspan": {
          "default": 1,
          "minimum": 1,
          "title": "Colspan",
          "type": "integer"
        },
        "row_kind": {
          "default": "UNKNOWN",
          "enum": [
            "HEADER",
            "BODY",
            "TOTAL",
            "NOTE",
            "UNKNOWN"
          ],
          "title": "Row Kind",
          "type": "string"
        },
        "bbox_fragments": {
          "items": {
            "items": {
              "type": "number"
            },
            "maxItems": 4,
            "minItems": 4,
            "type": "array"
          },
          "title": "Bbox Fragments",
          "type": "array"
        },
        "line_ids": {
          "items": {
            "type": "string"
          },
          "title": "Line Ids",
          "type": "array"
        }
      },
      "required": [
        "cell_id",
        "text"
      ],
      "title": "Cell",
      "type": "object"
    },
    "EngineInfo": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "EngineInfo",
      "type": "object"
    },
    "ExecutionInfo": {
      "additionalProperties": false,
      "properties": {
        "execution_manifest_id": {
          "title": "Execution Manifest Id",
          "type": "string"
        },
        "config_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Config Digest"
        },
        "policy_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Policy Digest"
        },
        "source_version_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Version Digest"
        },
        "replay": {
          "default": false,
          "title": "Replay",
          "type": "boolean"
        }
      },
      "required": [
        "execution_manifest_id"
      ],
      "title": "ExecutionInfo",
      "type": "object"
    },
    "PageImageRef": {
      "additionalProperties": false,
      "properties": {
        "uri": {
          "title": "Uri",
          "type": "string"
        },
        "width_px": {
          "exclusiveMinimum": 0,
          "title": "Width Px",
          "type": "integer"
        },
        "height_px": {
          "exclusiveMinimum": 0,
          "title": "Height Px",
          "type": "integer"
        }
      },
      "required": [
        "uri",
        "width_px",
        "height_px"
      ],
      "title": "PageImageRef",
      "type": "object"
    },
    "PageQuality": {
      "additionalProperties": false,
      "properties": {
        "line_count": {
          "minimum": 0,
          "title": "Line Count",
          "type": "integer"
        },
        "lines_with_geometry": {
          "minimum": 0,
          "title": "Lines With Geometry",
          "type": "integer"
        },
        "low_confidence_lines": {
          "minimum": 0,
          "title": "Low Confidence Lines",
          "type": "integer"
        }
      },
      "required": [
        "line_count",
        "lines_with_geometry",
        "low_confidence_lines"
      ],
      "title": "PageQuality",
      "type": "object"
    },
    "Row": {
      "additionalProperties": false,
      "properties": {
        "row_id": {
          "title": "Row Id",
          "type": "string"
        },
        "cells": {
          "items": {
            "$ref": "#/$defs/Cell"
          },
          "title": "Cells",
          "type": "array"
        }
      },
      "required": [
        "row_id",
        "cells"
      ],
      "title": "Row",
      "type": "object"
    },
    "SnapshotBlock": {
      "additionalProperties": false,
      "description": "Recommended (not required) heading/paragraph grouping; see handoff §4.\n\nNot yet populated by BuildSnapshot in this version — AI2 may merge line\nbboxes into clause-region bboxes itself in the interim, as the handoff\nrequest explicitly allows.",
      "properties": {
        "block_id": {
          "title": "Block Id",
          "type": "string"
        },
        "type": {
          "enum": [
            "heading",
            "paragraph"
          ],
          "title": "Type",
          "type": "string"
        },
        "line_ids": {
          "items": {
            "type": "string"
          },
          "title": "Line Ids",
          "type": "array"
        },
        "reading_order": {
          "minimum": 0,
          "title": "Reading Order",
          "type": "integer"
        },
        "bbox_normalized": {
          "items": {
            "type": "number"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Bbox Normalized",
          "type": "array"
        },
        "geometry_provenance": {
          "enum": [
            "MEASURED",
            "DERIVED",
            "CLAIMED"
          ],
          "title": "Geometry Provenance",
          "type": "string"
        }
      },
      "required": [
        "block_id",
        "type",
        "line_ids",
        "reading_order",
        "bbox_normalized",
        "geometry_provenance"
      ],
      "title": "SnapshotBlock",
      "type": "object"
    },
    "SnapshotLine": {
      "additionalProperties": false,
      "properties": {
        "line_id": {
          "title": "Line Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "page_char_start": {
          "minimum": 0,
          "title": "Page Char Start",
          "type": "integer"
        },
        "page_char_end": {
          "minimum": 0,
          "title": "Page Char End",
          "type": "integer"
        },
        "bbox_normalized": {
          "items": {
            "type": "number"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Bbox Normalized",
          "type": "array"
        },
        "geometry_provenance": {
          "enum": [
            "MEASURED",
            "DERIVED",
            "CLAIMED"
          ],
          "title": "Geometry Provenance",
          "type": "string"
        },
        "word_ids": {
          "items": {
            "type": "string"
          },
          "title": "Word Ids",
          "type": "array"
        },
        "bbox_source": {
          "anyOf": [
            {
              "enum": [
                "MEASURED",
                "DERIVED",
                "CLAIMED"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bbox Source"
        },
        "geometry_status": {
          "default": "AVAILABLE",
          "enum": [
            "AVAILABLE",
            "UNAVAILABLE"
          ],
          "title": "Geometry Status",
          "type": "string"
        },
        "engine_confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Engine Confidence"
        }
      },
      "required": [
        "line_id",
        "text",
        "page_char_start",
        "page_char_end",
        "bbox_normalized",
        "geometry_provenance"
      ],
      "title": "SnapshotLine",
      "type": "object"
    },
    "SnapshotPage": {
      "additionalProperties": false,
      "properties": {
        "page_number": {
          "minimum": 1,
          "title": "Page Number",
          "type": "integer"
        },
        "status": {
          "enum": [
            "SUCCESS",
            "PARTIAL",
            "FAILED"
          ],
          "title": "Status",
          "type": "string"
        },
        "input_type": {
          "enum": [
            "TEXT_LAYER",
            "SCANNED_OCR",
            "MIXED"
          ],
          "title": "Input Type",
          "type": "string"
        },
        "source_page_width": {
          "exclusiveMinimum": 0,
          "title": "Source Page Width",
          "type": "number"
        },
        "source_page_height": {
          "exclusiveMinimum": 0,
          "title": "Source Page Height",
          "type": "number"
        },
        "rotation_degrees": {
          "default": 0,
          "title": "Rotation Degrees",
          "type": "integer"
        },
        "page_image_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/PageImageRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "text": {
          "default": "",
          "title": "Text",
          "type": "string"
        },
        "lines": {
          "items": {
            "$ref": "#/$defs/SnapshotLine"
          },
          "title": "Lines",
          "type": "array"
        },
        "words": {
          "items": {
            "$ref": "#/$defs/SnapshotWord"
          },
          "title": "Words",
          "type": "array"
        },
        "blocks": {
          "items": {
            "$ref": "#/$defs/SnapshotBlock"
          },
          "title": "Blocks",
          "type": "array"
        },
        "table_status": {
          "default": "NOT_CHECKED",
          "enum": [
            "NOT_CHECKED",
            "NOT_PRESENT",
            "DETECTED"
          ],
          "title": "Table Status",
          "type": "string"
        },
        "tables": {
          "items": {
            "$ref": "#/$defs/Table"
          },
          "title": "Tables",
          "type": "array"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/SnapshotWarning"
          },
          "title": "Warnings",
          "type": "array"
        },
        "page_revision_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Revision Id"
        },
        "raw_text_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Text Digest"
        },
        "quality": {
          "anyOf": [
            {
              "$ref": "#/$defs/PageQuality"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "table_coverage": {
          "anyOf": [
            {
              "$ref": "#/$defs/TableCoverage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        }
      },
      "required": [
        "page_number",
        "status",
        "input_type",
        "source_page_width",
        "source_page_height"
      ],
      "title": "SnapshotPage",
      "type": "object"
    },
    "SnapshotWarning": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "line_ids": {
          "items": {
            "type": "string"
          },
          "title": "Line Ids",
          "type": "array"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "SnapshotWarning",
      "type": "object"
    },
    "SnapshotWord": {
      "additionalProperties": false,
      "properties": {
        "word_id": {
          "title": "Word Id",
          "type": "string"
        },
        "line_id": {
          "title": "Line Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "line_char_start": {
          "minimum": 0,
          "title": "Line Char Start",
          "type": "integer"
        },
        "line_char_end": {
          "minimum": 0,
          "title": "Line Char End",
          "type": "integer"
        },
        "bbox_normalized": {
          "items": {
            "type": "number"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Bbox Normalized",
          "type": "array"
        },
        "geometry_provenance": {
          "enum": [
            "MEASURED",
            "DERIVED",
            "CLAIMED"
          ],
          "title": "Geometry Provenance",
          "type": "string"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "bbox_source": {
          "anyOf": [
            {
              "enum": [
                "MEASURED",
                "DERIVED",
                "CLAIMED"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bbox Source"
        },
        "geometry_status": {
          "default": "AVAILABLE",
          "enum": [
            "AVAILABLE",
            "UNAVAILABLE"
          ],
          "title": "Geometry Status",
          "type": "string"
        },
        "engine_confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Engine Confidence"
        }
      },
      "required": [
        "word_id",
        "line_id",
        "text",
        "line_char_start",
        "line_char_end",
        "bbox_normalized",
        "geometry_provenance"
      ],
      "title": "SnapshotWord",
      "type": "object"
    },
    "StructuralNode": {
      "additionalProperties": false,
      "description": "One node of the document's clause hierarchy (section 8): Document ->\nSection/Article -> Clause -> Point. Built by `application.use_cases.\nbuild_structure.BuildStructure` from real OCR lines — every node resolves\nto the `line_ids` it was built from, which resolve to real `SnapshotLine`s\non a real page. See that module's docstring for the current limitation\n(no cross-page merging of a clause body split by a page break yet).",
      "properties": {
        "node_id": {
          "minLength": 1,
          "title": "Node Id",
          "type": "string"
        },
        "type": {
          "enum": [
            "ARTICLE",
            "CLAUSE",
            "POINT",
            "UNMARKED"
          ],
          "title": "Type",
          "type": "string"
        },
        "label_raw": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label Raw"
        },
        "label_normalized": {
          "minLength": 1,
          "title": "Label Normalized",
          "type": "string"
        },
        "parent_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Id"
        },
        "page_start": {
          "minimum": 1,
          "title": "Page Start",
          "type": "integer"
        },
        "page_end": {
          "minimum": 1,
          "title": "Page End",
          "type": "integer"
        },
        "line_ids": {
          "items": {
            "type": "string"
          },
          "title": "Line Ids",
          "type": "array"
        },
        "bbox_normalized": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "maxItems": 4,
              "minItems": 4,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bbox Normalized"
        },
        "geometry_provenance": {
          "anyOf": [
            {
              "enum": [
                "MEASURED",
                "DERIVED",
                "CLAIMED"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Geometry Provenance"
        }
      },
      "required": [
        "node_id",
        "type",
        "label_normalized",
        "page_start",
        "page_end"
      ],
      "title": "StructuralNode",
      "type": "object"
    },
    "Table": {
      "additionalProperties": false,
      "properties": {
        "table_id": {
          "title": "Table Id",
          "type": "string"
        },
        "bbox_normalized": {
          "items": {
            "type": "number"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Bbox Normalized",
          "type": "array"
        },
        "geometry_provenance": {
          "enum": [
            "MEASURED",
            "DERIVED",
            "CLAIMED"
          ],
          "title": "Geometry Provenance",
          "type": "string"
        },
        "header": {
          "items": {
            "type": "string"
          },
          "title": "Header",
          "type": "array"
        },
        "rows": {
          "items": {
            "$ref": "#/$defs/Row"
          },
          "title": "Rows",
          "type": "array"
        },
        "logical_table_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Logical Table Id"
        },
        "fragment_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fragment Id"
        },
        "continuation": {
          "default": "START",
          "enum": [
            "START",
            "CONTINUED",
            "UNCERTAIN"
          ],
          "title": "Continuation",
          "type": "string"
        }
      },
      "required": [
        "table_id",
        "bbox_normalized",
        "geometry_provenance",
        "rows"
      ],
      "title": "Table",
      "type": "object"
    },
    "TableContinuityLink": {
      "additionalProperties": false,
      "description": "One cross-page continuity decision (section 11) between the last table on one\npage and the first table on the next. Does not merge rows/cells -- only records the\ndecision and why, same as `backend/app/tables.py`'s own `link_continuations`\n(independently landing on the same \"link, don't merge\" answer). No LLM gray-zone\nagent produced this in the current build (deterministic only -- see\ndocs/ai1-decisions.md D8); MERGE/SPLIT come from hard guards and a deterministic\nscore, anything in between is NEEDS_REVIEW rather than a guess.",
      "properties": {
        "from_table_id": {
          "title": "From Table Id",
          "type": "string"
        },
        "from_page": {
          "minimum": 1,
          "title": "From Page",
          "type": "integer"
        },
        "to_table_id": {
          "title": "To Table Id",
          "type": "string"
        },
        "to_page": {
          "minimum": 1,
          "title": "To Page",
          "type": "integer"
        },
        "decision": {
          "enum": [
            "MERGE",
            "SPLIT",
            "NEEDS_REVIEW"
          ],
          "title": "Decision",
          "type": "string"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        }
      },
      "required": [
        "from_table_id",
        "from_page",
        "to_table_id",
        "to_page",
        "decision",
        "confidence"
      ],
      "title": "TableContinuityLink",
      "type": "object"
    },
    "TableCoverage": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "NOT_CHECKED",
            "NOT_PRESENT",
            "DETECTED"
          ],
          "title": "Status",
          "type": "string"
        },
        "detected_table_count": {
          "minimum": 0,
          "title": "Detected Table Count",
          "type": "integer"
        },
        "examined_area_ratio": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Examined Area Ratio"
        }
      },
      "required": [
        "status",
        "detected_table_count"
      ],
      "title": "TableCoverage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "ai1.snapshot.v1",
      "default": "ai1.snapshot.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "snapshot_id": {
      "minLength": 1,
      "title": "Snapshot Id",
      "type": "string"
    },
    "parent_snapshot_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Snapshot Id"
    },
    "run_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Run Id"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "status": {
      "anyOf": [
        {
          "enum": [
            "SUCCESS",
            "PARTIAL",
            "FAILED"
          ],
          "type": "string"
